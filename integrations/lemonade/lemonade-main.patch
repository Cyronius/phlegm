@@ -0,0 +1,26 @@
+#pragma once
+
+#include "lemon/backends/backend_registry.h"
+#include "lemon/wrapped_server.h"
+
+namespace lemon { namespace backends {
+
+class PhlegmServer : public WrappedServer {
+public:
+    PhlegmServer(const std::string& log_level, ModelManager* model_manager,
+                 BackendManager* backend_manager);
+
+    void load(const std::string& model_name, const ModelInfo& model_info,
+              const RecipeOptions& options, bool do_not_upgrade = false) override;
+    json chat_completion(const json& request) override;
+    json completion(const json& request) override;
+};
+
+namespace phlegm {
+std::unique_ptr<WrappedServer> create(const BackendContext& ctx);
+const BackendSpec* spec();
+const BackendOps* ops();
+constexpr uint32_t capabilities() { return capability_mask_of<PhlegmServer>(); }
+}
+
+}}  // namespace lemon::backends
diff --git a/src/cpp/server/backends/phlegm/phlegm_server.cpp b/src/cpp/server/backends/phlegm/phlegm_server.cpp
new file mode 100644
index 0000000..4e94fdb
--- /dev/null
+++ b/src/cpp/server/backends/phlegm/phlegm_server.cpp
@@ -0,0 +1,100 @@
+#include "lemon/backends/phlegm/phlegm_server.h"
+
+#include "lemon/backends/backend_ops.h"
+#include "lemon/backends/backend_utils.h"
+#include "lemon/backends/phlegm/phlegm.h"
+#include "lemon/utils/path_utils.h"
+
+#include <filesystem>
+#include <stdexcept>
+
+namespace lemon { namespace backends {
+
+namespace {
+
+class PhlegmOps : public BackendOps {
+public:
+    std::string validate_registration_checkpoint(const std::string& checkpoint) const override {
+        const std::filesystem::path path = utils::path_from_utf8(checkpoint);
+        if (!path.is_absolute()) return "Phlegm's main checkpoint must be an absolute model directory";
+        std::error_code ec;
+        if (!std::filesystem::is_directory(path, ec)) return "Phlegm model directory does not exist: " + checkpoint;
+        return "";
+    }
+
+    std::string validate_checkpoint_file(const std::string& path) const override {
+        std::error_code ec;
+        return std::filesystem::is_directory(utils::path_from_utf8(path), ec)
+            ? "" : "Phlegm checkpoint must be a model directory";
+    }
+
+    InstallCheck check_install(const std::string&, bool) const override {
+        const bool found = !utils::find_executable_in_path(phlegm::descriptor.binary).empty();
+        return {found, found ? "" : "Install phlegm and put its executable on PATH"};
+    }
+
+    DownloadPolicy plan_download(const ModelInfo&, const BackendOpsContext&) const override {
+        return DownloadPolicy::None;
+    }
+};
+
+}  // namespace
+
+PhlegmServer::PhlegmServer(const std::string& log_level, ModelManager* model_manager,
+                           BackendManager* backend_manager)
+    : WrappedServer("Phlegm", log_level, model_manager, backend_manager) {}
+
+void PhlegmServer::load(const std::string& model_name, const ModelInfo& model_info,
+                        const RecipeOptions& options, bool do_not_upgrade) {
+    (void)do_not_upgrade;
+    const std::string binary = utils::find_executable_in_path(phlegm::descriptor.binary);
+    if (binary.empty()) throw std::runtime_error("phlegm executable not found on PATH");
+
+    const std::string model_dir = model_info.resolved_path();
+    if (auto error = phlegm::ops()->validate_checkpoint_file(model_dir); !error.empty()) {
+        throw std::runtime_error(error + ": " + model_dir);
+    }
+
+    device_type_ = DEVICE_NPU;
+    port_ = choose_port();
+    ServerCommand command;
+    command.program = binary;
+    command.args = {"serve", "--model-dir", model_dir,
+                    "--model-id", model_name,
+                    "--host", "127.0.0.1", "--port", std::to_string(port_)};
+    const int ctx_size = options.get_option("ctx_size");
+    if (ctx_size > 0) {
+        command.args.insert(command.args.end(), {"--max-ctx", std::to_string(ctx_size)});
+    }
+    for (const auto& [option, flag] : {
+             std::pair<const char*, const char*>{"phlegm_kernels", "--kernels"},
+             {"phlegm_bridge", "--bridge"}}) {
+        const std::string value = options.get_option(option);
+        if (!value.empty()) command.args.insert(command.args.end(), {flag, value});
+    }
+    command.port = port_;
+    command.ready_endpoint = "/health";
+    const bool inherit_output = (log_level_ == "info") || is_debug();
+    start_server(std::make_unique<NativeProcess>(ProcessOutput{inherit_output, true}), command, 900);
+}
+
+json PhlegmServer::chat_completion(const json& request) {
+    return forward_request("/v1/chat/completions", request);
+}
+
+json PhlegmServer::completion(const json& request) {
+    return forward_request("/v1/completions", request);
+}
+
+namespace phlegm {
+std::unique_ptr<WrappedServer> create(const BackendContext& ctx) {
+    return make_server<PhlegmServer>(ctx);
+}
+const BackendSpec* spec() {
+    static const BackendSpec kSpec(descriptor.recipe, descriptor.binary);
+    return &kSpec;
+}
+const BackendOps* ops() { return single_ops<PhlegmOps>(); }
+}
+
+}}  // namespace lemon::backends
