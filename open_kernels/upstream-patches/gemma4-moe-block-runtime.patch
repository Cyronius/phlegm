+// Gemma 4 26B-A4B's layer close on the block route (OPEN-FAMILY-GEMMA4-MOE), the sequential program's
+// gemma4_route / gm_moe / gemma4_combine over a block: t1 = post_ffw_norm_1(mlp); the router and
+// xm2 = pre_ffw_norm_2 over res (the f32 residual, as the sequential act holds it); the experts through
+// the token-batched kernel (moe_block); xres = res + post_ffw_norm'(t1 + post_ffw_norm_2(m)).
+void Core::g4_moe_tail(int l, const std::vector<double>& res1, const std::vector<float>& y_down, size_t T, size_t t_real,
+                       std::vector<double>& xres) {
+    const GemmBlockProgram& gb = types_[l]->gemm_block;
+    if (!moe_batch_on_ || !gb.moe_batch.present())
+        throw std::runtime_error("open_qwen36: layer " + std::to_string(l) + ": the Gemma 4 MoE block route needs the token-batched "
+                                 "expert kernel (OFLM_OPEN_MOE_BATCH=0 turns it off)");
+    const size_t hid = w_->hidden, E = w_->moe.experts, K = w_->moe.topk;
+    if (K > 8 || K > E) throw std::runtime_error("open_qwen36: gemma4 block route geometry");
+    moe_stage_resize(T);
+    if (moe_.m.size() < T * hid) moe_.m.resize(T * hid);
+    G4Moe& g = g4moe(gb.g4_route, l);
+    G4Moe& gc = g4moe(gb.g4_combine, l);
+    const double eps = gb.g4_route.eps;
+    std::vector<float>& t1 = moe_.t1;
+    if (t1.size() < T * hid) t1.resize(T * hid);
+    auto tr = std::chrono::steady_clock::now();
+    const double sc = 1.0 / std::sqrt(static_cast<double>(hid));
+#pragma omp parallel
+    {
+        std::vector<double> r(hid), xm(hid), logit(E), tmp(hid);
+        std::vector<uint32_t> order(E);
+#pragma omp for schedule(static)
+        for (long long ti = 0; ti < static_cast<long long>(T); ++ti) {
+            const size_t t = static_cast<size_t>(ti);
+            float* res = moe_.res.data() + t * hid;
+            for (size_t i = 0; i < hid; ++i) res[i] = static_cast<float>(res1[t * hid + i]);
+            // t1: the dense MLP's output normed by post_ffw_norm_1 (the consts' bf16 weight, as dx's)
+            g4_rms(y_down.data() + t * hid, hid, eps, post_ffn_w_[l].data(), tmp.data());
+            for (size_t i = 0; i < hid; ++i) t1[t * hid + i] = static_cast<float>(tmp[i]);
+            if (t >= t_real) continue;
+            g4_rms(res, hid, eps, nullptr, r.data());
+            for (size_t i = 0; i < hid; ++i) r[i] *= g.router_scale[i] * sc;
+            for (size_t e = 0; e < E; ++e) {
+                const float* wr = g.router.data() + e * hid;
+                double a8[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+                size_t i = 0;
+                for (; i + 8 <= hid; i += 8)
+                    for (size_t j = 0; j < 8; ++j) a8[j] += static_cast<double>(wr[i + j]) * r[i + j];
+                for (size_t j = 0; i < hid; ++i, ++j) a8[j] += static_cast<double>(wr[i]) * r[i];
+                logit[e] = ((a8[0] + a8[1]) + (a8[2] + a8[3])) + ((a8[4] + a8[5]) + (a8[6] + a8[7]));
+            }
+            for (size_t e = 0; e < E; ++e) order[e] = static_cast<uint32_t>(e);
+            std::stable_sort(order.begin(), order.end(), [&](uint32_t x, uint32_t y) { return logit[x] > logit[y]; });
+            const double mx = logit[order[0]];
+            double sum = 0.0;
+            for (size_t j = 0; j < K; ++j) sum += std::exp(logit[order[j]] - mx);
+            for (size_t j = 0; j < K; ++j) {
+                moe_.idx[t * K + j] = static_cast<int32_t>(order[j]);
+                moe_.w[t * K + j] = static_cast<float>(std::exp(logit[order[j]] - mx) / sum * g.expert_scale[order[j]]);
+            }
+            g4_rms(res, hid, eps, g.pre_norm.data(), xm.data());
+            for (size_t i = 0; i < hid; ++i) moe_.xm[t * hid + i] = static_cast<float>(xm[i]);
+        }
+    }
+    timing_.moe_prep_ms += ms_since(tr);
+    moe_block(l, moe_.xm.data(), nullptr, moe_.idx.data(), moe_.w.data(), T, t_real, moe_.m.data());
+    auto tc = std::chrono::steady_clock::now();
+#pragma omp parallel
+    {
+        std::vector<double> t2(hid), y(hid);
+        std::vector<float> sum(hid);
+#pragma omp for schedule(static)
+        for (long long ti = 0; ti < static_cast<long long>(T); ++ti) {
+            const size_t t = static_cast<size_t>(ti);
+            const float* res = moe_.res.data() + t * hid;
+            if (t >= t_real) {                   // padding: carried, never read
+                for (size_t i = 0; i < hid; ++i) xres[t * hid + i] = res[i];
+                continue;
+            }
+            g4_rms(moe_.m.data() + t * hid, hid, eps, gc.post_norm2.data(), t2.data());
+            for (size_t i = 0; i < hid; ++i) sum[i] = static_cast<float>(t1[t * hid + i] + t2[i]);
+            g4_rms(sum.data(), hid, eps, gc.post_norm.data(), y.data());
+            for (size_t i = 0; i < hid; ++i) xres[t * hid + i] = static_cast<float>(res[i] + y[i]);
+        }
+    }
+    timing_.tail_ms += ms_since(tc);
+}
