+// The llama.cpp i-quant / low-k-quant blocks (IQ1_S, IQ1_M, IQ2_XXS, IQ2_XS, IQ2_S, IQ3_XXS, IQ3_S,
+// IQ4_XS, Q2_K) decoded one 32-value sub-block at a time, for the q35 pack ops (Underdog Saluki 27B,
+// OPEN-FAMILY-SALUKI). Each decoder follows ggml-quants.c's dequantize_row_* (llama.cpp a34de8618b25)
+// value for value, so `v` is bit-identical to llama.cpp's own dequantization of the block.
+//
+// Besides the f32 values, a decoder states the block's INTEGER LAW when it has one: v[i] == s * c[i]
+// exactly, with one f32 scale `s` for all 32 values and |c[i]| <= 127. That is what lets the q8 law
+// (int8 codes, one bf16 scale a 32-block: gemv_q8.h) keep the GGUF's codes, rounding only the scale:
+//   IQ2_XXS  s = d (2 ls + 1) / 8,  c = +-grid in {8, 25, 43}
+//   IQ3_XXS  s = d (2 ls + 1) / 4,  c = +-grid in {4, 12, ..., 62}
+//   IQ3_S    s = d (2 sc + 1),      c = +-grid in {1, 3, ..., 15}
+//   IQ1_S    s = d (2 k + 1) / 8,   c = 8 g +- 1, g in {-1, 0, 1}
+//   IQ4_XS   s = d (ls - 32),       c = kvalues_iq4nl
+//   IQ2_XS / IQ2_S / IQ1_M: two scales a 32-block; the law holds with s = the common factor when
+//            every scaled code fits in int8 (checked per block), otherwise the block has none
+//   Q2_K     scale and min per 16 values: no integer law
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+
+#include "gguf_iq_tables.hpp"
+
+namespace open_qwen36::iq {
+
+/// One decoded 32-value sub-block.
+struct Block32 {
+    float v[32];
+    bool law = false;   // v[i] == s * c[i] exactly
+    float s = 0.f;
+    int8_t c[32];
+};
+
+/// fp16 bits -> f32 (exact).
+inline float half(const uint8_t* p) {
+    uint16_t h;
+    std::memcpy(&h, p, 2);
+    const uint32_t sign = (h & 0x8000u) << 16, e = (h >> 10) & 0x1f, m = h & 0x3ff;
+    uint32_t u;
+    if (e == 0) {
+        if (m == 0) {
+            u = sign;
+        } else {
+            int ee = -1;
+            uint32_t mm = m;
+            do { ++ee; mm <<= 1; } while (!(mm & 0x400));
+            u = sign | ((127 - 15 - ee) << 23) | ((mm & 0x3ff) << 13);
+        }
+    } else if (e == 31) {
+        u = sign | 0x7f800000u | (m << 13);
+    } else {
+        u = sign | ((e + 127 - 15) << 23) | (m << 13);
+    }
+    float f;
+    std::memcpy(&f, &u, 4);
+    return f;
+}
+
+/// Bytes per 256-value super-block of the types this header decodes (0: not one of them).
+inline unsigned block_bytes(uint32_t type) {
+    switch (type) {
+        case 10: return 84;    // Q2_K
+        case 16: return 66;    // IQ2_XXS
+        case 17: return 74;    // IQ2_XS
+        case 18: return 98;    // IQ3_XXS
+        case 19: return 50;    // IQ1_S
+        case 21: return 110;   // IQ3_S
+        case 22: return 82;    // IQ2_S
+        case 23: return 136;   // IQ4_XS
+        case 29: return 56;    // IQ1_M
+        default: return 0;
+    }
+}
+
+namespace detail {
+/// v = s * c with c = k[i] * mult[i / 16]: the law holds when every product fits int8.
+inline void two_scale_law(Block32& o, float s, const int* k, const int mult[2]) {
+    o.s = s;
+    o.law = true;
+    for (int i = 0; i < 32; ++i) {
+        const int c = k[i] * mult[i / 16];
+        if (c < -127 || c > 127) { o.law = false; return; }
+        o.c[i] = static_cast<int8_t>(c);
+    }
+}
+inline float sgn(uint8_t signs, int j) { return (signs & kmask_iq2xs[j]) ? -1.f : 1.f; }
+inline int isgn(uint8_t signs, int j) { return (signs & kmask_iq2xs[j]) ? -1 : 1; }
+}  // namespace detail
