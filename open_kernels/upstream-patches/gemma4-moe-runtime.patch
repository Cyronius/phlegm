+Core::G4Moe& Core::g4moe(const Step& s, int layer) {
+    auto it = g4moe_.find(layer);
+    if (it != g4moe_.end() && !(s.op == "gemma4_route" ? it->second.router.empty() : it->second.post_norm.empty()))
+        return it->second;
+    G4Moe& g = g4moe_[layer];
+    auto name = [&](const std::string& t, const char* key, int v) {
+        std::string n = t;
+        for (size_t p = n.find(key); p != std::string::npos; p = n.find(key)) n.replace(p, 3, std::to_string(v));
+        return n;
+    };
+    const size_t hid = w_->hidden, E = w_->moe.experts;
+    auto want = [&](const std::vector<float>& v, size_t n, const std::string& what) {
+        if (v.size() != n)
+            throw std::runtime_error("open_qwen36: layer " + std::to_string(layer) + ": " + what + " has " +
+                                     std::to_string(v.size()) + " values, not " + std::to_string(n));
+    };
+    if (s.op == "gemma4_route") {
+        g.router = file_->f32(name(s.router, "{l}", layer));
+        g.router_scale = file_->f32(name(s.router_scale, "{l}", layer));
+        g.expert_scale = file_->f32(name(s.expert_scale, "{l}", layer));
+        g.pre_norm = file_->f32(name(s.pre_norm, "{l}", layer));
+        want(g.router, E * hid, "the router");
+        want(g.router_scale, hid, "the router scale");
+        want(g.expert_scale, E, "the per-expert scale");
+        want(g.pre_norm, hid, "pre_ffw_norm_2");
+    } else {
+        g.post_norm2 = file_->f32(name(s.post_norm2, "{l}", layer));
+        g.post_norm = file_->f32(name(s.post_norm, "{l}", layer));
+        want(g.post_norm2, hid, "post_ffw_norm_2");
+        want(g.post_norm, hid, "post_ffw_norm");
+        // the residual is carried divided by the layer scalars before this layer (pools.cpp put's
+        // div_running), so the block output added to it is too
+        double div = 1.0;
+        for (int j = 0; j < layer; ++j) {
+            const std::vector<float> v = file_->f32(name(s.div_running, "{j}", j));
+            if (v.size() != 1) throw std::runtime_error("open_qwen36: " + name(s.div_running, "{j}", j) + " is not one value");
+            div *= v[0];
+        }
+        if (!(div > 0.0) || !std::isfinite(div)) throw std::runtime_error("open_qwen36: gemma4_combine fold " + std::to_string(div));
+        for (float& w : g.post_norm) w = static_cast<float>(w / div);
+    }
+    return g;
+}
+
+namespace {
+// x * (mean(x^2) + eps)^-0.5 in double, then the weight (Gemma 4: x * w)
+void g4_rms(const float* x, size_t n, double eps, const float* w, double* out) {
+    double ss = 0.0;
+    for (size_t i = 0; i < n; ++i) ss += static_cast<double>(x[i]) * x[i];
+    const double r = 1.0 / std::sqrt(ss / static_cast<double>(n) + eps);
+    for (size_t i = 0; i < n; ++i) out[i] = x[i] * r * (w ? static_cast<double>(w[i]) : 1.0);
+}
+}  // namespace
+
+void Core::gemma4_route(const Step& s, int layer) {
+    // Gemma 4 26B-A4B's router (OPEN-FAMILY-GEMMA4-MOE; transformers Gemma4TextRouter, llama.cpp
+    // gemma4.cpp): over res, the residual after attention, RMS-normed without weight, times the router
+    // scale and hidden^-0.5; logits through the F32 router; softmax over every expert, the top k (ties
+    // to the lower expert), renormalised over those, times per_expert_scale. xm2 = pre_ffw_norm_2(res)
+    // goes to gm_moe as bf16 with the weights at a_w; the chosen experts into its fills (moeroute2).
+    auto t0 = std::chrono::steady_clock::now();
+    Kern& k = kerns_.at(s.kernel);
+    if (k.moe2.empty()) throw std::runtime_error("open_qwen36: gemma4_route on " + k.name + ", which has no routed-expert table");
+    const size_t hid = w_->hidden, E = w_->moe.experts, K = w_->moe.topk;
+    if (K > 8 || K > E) throw std::runtime_error("open_qwen36: gemma4_route geometry");
+    G4Moe& g = g4moe(s, layer);
+    xrt::bo& act = act_[layer];
+    read_back(act, hid * 4, s.a_res);
+    uint8_t* a = act.map<uint8_t*>();
+    const float* res = reinterpret_cast<const float*>(a + s.a_res);
+    std::vector<double> r(hid), xm(hid);
+    g4_rms(res, hid, s.eps, nullptr, r.data());
+    const double sc = 1.0 / std::sqrt(static_cast<double>(hid));
+    for (size_t i = 0; i < hid; ++i) r[i] *= g.router_scale[i] * sc;
+    std::vector<double> logit(E);
+    for (size_t e = 0; e < E; ++e) {
+        const float* wr = g.router.data() + e * hid;
+        double acc = 0.0;
+        for (size_t i = 0; i < hid; ++i) acc += static_cast<double>(wr[i]) * r[i];
+        logit[e] = acc;
+    }
+    std::vector<uint32_t> order(E);
+    for (size_t e = 0; e < E; ++e) order[e] = static_cast<uint32_t>(e);
+    std::stable_sort(order.begin(), order.end(), [&](uint32_t x, uint32_t y) { return logit[x] > logit[y]; });
+    uint32_t idx[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    float wv[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    const double mx = logit[order[0]];
+    double sum = 0.0;
+    for (size_t j = 0; j < K; ++j) sum += std::exp(logit[order[j]] - mx);
+    for (size_t j = 0; j < K; ++j) {
+        idx[j] = order[j];
+        wv[j] = static_cast<float>(std::exp(logit[order[j]] - mx) / sum * g.expert_scale[idx[j]]);
+    }
+    g4_rms(res, hid, s.eps, g.pre_norm.data(), xm.data());
+    uint16_t* xb = reinterpret_cast<uint16_t*>(a + s.a_xm);
+    for (size_t i = 0; i < hid; ++i) xb[i] = f32_to_bf16(static_cast<float>(xm[i]));
+    std::memcpy(a + s.a_w, wv, sizeof wv);
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, s.a_w + sizeof wv - s.a_xm, s.a_xm);
+    if (route_log_on_) {
+        std::vector<uint8_t> rec(sizeof idx + sizeof wv);
+        std::memcpy(rec.data(), idx, sizeof idx);
+        std::memcpy(rec.data() + sizeof idx, wv, sizeof wv);
+        route_log_.push_back({layer, rec});
+    }
+    stream_patch::moe2_apply(k.iw(), k.moe2, idx, w_->moe);
+    k.instr->sync(XCL_BO_SYNC_BO_TO_DEVICE);
+    timing_.route_ms += ms_since(t0);
+}
+
+void Core::gemma4_combine(const Step& s, int layer) {
+    // Gemma 4 26B-A4B's FFN close (OPEN-FAMILY-GEMMA4-MOE): xres = res + post_ffw_norm'(t1 +
+    // post_ffw_norm_2(m)), t1 = post_ffw_norm_1(mlp) from dx, m the experts' sum from gm_moe,
+    // post_ffw_norm' the file's weight divided by the earlier layers' scalars (g4moe).
+    auto t0 = std::chrono::steady_clock::now();
+    const size_t hid = w_->hidden;
+    G4Moe& g = g4moe(s, layer);
+    xrt::bo& act = act_[layer];
+    read_back(act, hid * 4, s.a_res);
+    read_back(act, hid * 4, s.a_t1);
+    read_back(act, hid * 4, s.a_moe);
+    const uint8_t* a = act.map<uint8_t*>();
+    const float* res = reinterpret_cast<const float*>(a + s.a_res);
+    const float* t1 = reinterpret_cast<const float*>(a + s.a_t1);
+    const float* m = reinterpret_cast<const float*>(a + s.a_moe);
+    std::vector<double> t2(hid), y(hid);
+    g4_rms(m, hid, s.eps, g.post_norm2.data(), t2.data());
+    std::vector<float> sum(hid);
+    for (size_t i = 0; i < hid; ++i) sum[i] = static_cast<float>(t1[i] + t2[i]);
+    g4_rms(sum.data(), hid, s.eps, g.post_norm.data(), y.data());
+    xrt::bo& xres = buffer("xres", 0);
+    float* x = xres.map<float*>();
+    for (size_t i = 0; i < hid; ++i) x[i] = static_cast<float>(res[i] + y[i]);
+    xres.sync(XCL_BO_SYNC_BO_TO_DEVICE, hid * 4, 0);
+    timing_.route_ms += ms_since(t0);
+}
