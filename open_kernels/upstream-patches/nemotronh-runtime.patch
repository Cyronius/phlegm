+// ============================================================================
+// Nemotron-H (OPEN-FAMILY-NEMOTRONH, open_kernels/recipes/nemotronh.py; nemotronh-runtime.patch). A block is
+// x = x + mixer(rms(x) * norm); the NPU runs the projection GEMVs and the expert program, these host steps the
+// rest. The residual stays in the `xres` global's host map, f32, and never goes to the device; the Mamba state
+// (3 conv rows | the f32 SSM state) and the attention's f32 [K | V] rows live in the layer's state BO, host side.
+// ============================================================================
+
+namespace {
+double nh_num(const Step& s, const char* key) {
+    auto it = s.nh_n.find(key);
+    if (it == s.nh_n.end()) throw std::runtime_error("open_qwen36: " + s.op + " lacks the number '" + key + "'");
+    return it->second;
+}
+const std::string& nh_str(const Step& s, const char* key) {
+    auto it = s.nh_s.find(key);
+    if (it == s.nh_s.end()) throw std::runtime_error("open_qwen36: " + s.op + " lacks the string '" + key + "'");
+    return it->second;
+}
+size_t nh_sz(const Step& s, const char* key) { return static_cast<size_t>(nh_num(s, key)); }
+/// rms(x) * w over n values (the mean in double), as bf16 into dst, then zeros up to k
+void nh_rms_bf16(const float* x, const float* w, size_t n, size_t k, double eps, uint16_t* dst) {
+    double ss = 0.0;
+    for (size_t i = 0; i < n; ++i) ss += static_cast<double>(x[i]) * x[i];
+    const double r = 1.0 / std::sqrt(ss / static_cast<double>(n) + eps);
+    for (size_t i = 0; i < n; ++i) dst[i] = f32_to_bf16(static_cast<float>(x[i] * r * w[i]));
+    for (size_t i = n; i < k; ++i) dst[i] = 0;
+}
+inline float nh_silu(float v) { return v / (1.0f + std::exp(-v)); }
+/// the step's GEMV input format: f32 when the step says x_f32 (the one-image program), else bf16
+bool nh_f32(const Step& s) { auto it = s.nh_n.find("x_f32"); return it != s.nh_n.end() && it->second != 0.0; }
+/// write v[0..n) then zeros up to k at dst in the step's format; returns the bytes written
+size_t nh_put_x(const Step& s, const float* v, size_t n, size_t k, uint8_t* dst) {
+    if (nh_f32(s)) {
+        float* o = reinterpret_cast<float*>(dst);
+        std::memcpy(o, v, n * 4);
+        for (size_t i = n; i < k; ++i) o[i] = 0.0f;
+        return k * 4;
+    }
+    uint16_t* o = reinterpret_cast<uint16_t*>(dst);
+    for (size_t i = 0; i < n; ++i) o[i] = f32_to_bf16(v[i]);
+    for (size_t i = n; i < k; ++i) o[i] = 0;
+    return k * 2;
+}
+}  // namespace
+
+const std::vector<float>& Core::nh_tensor(const std::string& pattern, int layer, size_t n) {
+    std::string name = pattern;
+    const size_t at = name.find("{l}");
+    if (at != std::string::npos) name.replace(at, 3, std::to_string(layer));
+    auto it = nh_w_.find(name);
+    if (it != nh_w_.end()) return it->second;
+    std::vector<float> v = file_->f32(name);
+    if (n && v.size() != n)
+        throw std::runtime_error("open_qwen36: " + name + " has " + std::to_string(v.size()) + " values, the step wants " +
+                                 std::to_string(n));
+    return nh_w_.emplace(name, std::move(v)).first->second;
+}
+
+void Core::nh_step(const Step& s, int layer) {
+    auto t0 = std::chrono::steady_clock::now();
+    if (s.op == "nh_pre") nh_pre(s, layer);
+    else if (s.op == "nh_ssm") nh_ssm(s, layer);
+    else if (s.op == "nh_attn") nh_attn(s, layer);
+    else if (s.op == "nh_route") nh_route(s, layer);
+    else if (s.op == "nh_add") nh_add(s, layer);
+    else if (s.op == "nh_final") nh_final(s);
+    else throw std::runtime_error("open_qwen36: unknown host step " + s.op);
+    timing_.route_ms += ms_since(t0);
+}
+
+void Core::nh_pre(const Step& s, int layer) {
+    // the block's input norm: rms(x) * norm as the GEMV's bf16 x, zero-padded to the operand's K
+    const size_t hid = nh_sz(s, "hidden"), k = nh_sz(s, "k"), ax = nh_sz(s, "a_x");
+    const std::vector<float>& w = nh_tensor(nh_str(s, "norm"), layer, hid);
+    xrt::bo& act = act_[layer];
+    const float* x = buffer("xres", 0).map<float*>();
+    double ss = 0.0;
+    for (size_t i = 0; i < hid; ++i) ss += static_cast<double>(x[i]) * x[i];
+    const double r = 1.0 / std::sqrt(ss / static_cast<double>(hid) + nh_num(s, "eps"));
+    std::vector<float> xn(hid);
+    for (size_t i = 0; i < hid; ++i) xn[i] = static_cast<float>(x[i] * r * w[i]);
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, nh_put_x(s, xn.data(), hid, k, act.map<uint8_t*>() + ax), ax);
+}
+
+void Core::nh_add(const Step& s, int layer) {
+    // x += the mixer's output (f32 [hidden] at a_o)
+    const size_t hid = nh_sz(s, "hidden"), ao = nh_sz(s, "a_o");
+    xrt::bo& act = act_[layer];
+    read_back(act, hid * 4, ao);
+    const float* o = reinterpret_cast<const float*>(act.map<uint8_t*>() + ao);
+    float* x = buffer("xres", 0).map<float*>();
+    for (size_t i = 0; i < hid; ++i) x[i] += o[i];
+}
+
+void Core::nh_final(const Step& s) {
+    // the final norm into the head's bf16 input
+    const size_t hid = nh_sz(s, "hidden"), k = nh_sz(s, "k");
+    const std::vector<float>& w = nh_tensor(nh_str(s, "norm"), 0, hid);
+    xrt::bo& hn = buffer(nh_str(s, "dst"), 0);
+    if (hn.size() < k * 2) throw std::runtime_error("open_qwen36: nh_final: the head input is smaller than K");
+    nh_rms_bf16(buffer("xres", 0).map<float*>(), w.data(), hid, k, nh_num(s, "eps"), hn.map<uint16_t*>());
+    hn.sync(XCL_BO_SYNC_BO_TO_DEVICE, k * 2, 0);
+}
+
+void Core::nh_ssm(const Step& s, int layer) {
+    // Mamba-2 (transformers NemotronHMamba2Mixer, llama.cpp build_mamba2_layer) for one token, from the in_proj
+    // GEMV's [z | xBC | dt] (f32 at a_y) to the out GEMV's bf16 input (a_x):
+    //   xBC = silu(conv(previous 3 rows, xBC) + bias); dt = softplus(dt + dt_bias); dA = exp(dt A)
+    //   per head h (group g = h / (heads / groups)): S_h = S_h dA + dt x_h B_g^T;  y_h = S_h C_g + D_h x_h
+    //   y = y * silu(z); the grouped RMSNorm (groups of di / groups) * ssm_norm
+    const size_t nh = nh_sz(s, "heads"), hd = nh_sz(s, "head_dim"), ng = nh_sz(s, "groups"), ds = nh_sz(s, "dstate");
+    const size_t taps = nh_sz(s, "taps"), ay = nh_sz(s, "a_y"), ax = nh_sz(s, "a_x"), k = nh_sz(s, "k");
+    const size_t di = nh * hd, cdim = di + 2 * ng * ds, n_in = di + cdim + nh;
+    const double eps = nh_num(s, "eps");
+    if (taps < 2 || nh % ng || k < di || nh_sz(s, "state_conv") != (taps - 1) * cdim * 4)
+        throw std::runtime_error("open_qwen36: nh_ssm: the geometry does not fit the state");
+    const LayerType& lt = *types_[layer];
+    if (lt.state_bytes < (taps - 1) * cdim * 4 + nh * hd * ds * 4)
+        throw std::runtime_error("open_qwen36: nh_ssm: layer " + std::to_string(layer) + "'s state BO is too small");
+    const std::vector<float>& cw = nh_tensor(nh_str(s, "conv_w"), layer, cdim * taps);
+    const std::vector<float>& cb = nh_tensor(nh_str(s, "conv_b"), layer, cdim);
+    const std::vector<float>& dtb = nh_tensor(nh_str(s, "dt_b"), layer, nh);
+    const std::vector<float>& A = nh_tensor(nh_str(s, "ssm_a"), layer, nh);
+    const std::vector<float>& D = nh_tensor(nh_str(s, "ssm_d"), layer, nh);
+    const std::vector<float>& nw = nh_tensor(nh_str(s, "ssm_norm"), layer, di);
+    xrt::bo& act = act_[layer];
+    read_back(act, n_in * 4, ay);
+    const float* in = reinterpret_cast<const float*>(act.map<uint8_t*>() + ay);
+    const float* z = in;
+    const float* xbc = in + di;
+    const float* dtr = in + di + cdim;
+    float* conv = state_[layer].map<float*>();                    // [taps - 1][cdim], the oldest first
+    float* S = conv + (taps - 1) * cdim;                          // [nh][hd][ds]
+    std::vector<float> xc(cdim);
+#pragma omp parallel for schedule(static)
+    for (long long cc = 0; cc < static_cast<long long>(cdim); ++cc) {
+        const size_t c = static_cast<size_t>(cc);
+        const float* w = cw.data() + c * taps;                    // the GGUF's [cdim][taps]: the last tap on this token
+        double a = cb[c];
+        for (size_t t = 0; t + 1 < taps; ++t) a += static_cast<double>(w[t]) * conv[t * cdim + c];
+        a += static_cast<double>(w[taps - 1]) * xbc[c];
+        for (size_t t = 0; t + 2 < taps; ++t) conv[t * cdim + c] = conv[(t + 1) * cdim + c];
+        conv[(taps - 2) * cdim + c] = xbc[c];
+        xc[c] = nh_silu(static_cast<float>(a));
+    }
+    std::vector<float> y(di);
+    const size_t hpg = nh / ng;
+#pragma omp parallel for schedule(static)
+    for (long long hh = 0; hh < static_cast<long long>(nh); ++hh) {
+        const size_t h = static_cast<size_t>(hh), g = h / hpg;
+        const double u = static_cast<double>(dtr[h]) + dtb[h];
+        const float dt = static_cast<float>(u > 20.0 ? u : std::log1p(std::exp(u)));
+        const float dA = std::exp(dt * A[h]);
+        const float* xh = xc.data() + h * hd;
+        const float* B = xc.data() + di + g * ds;
+        const float* C = xc.data() + di + ng * ds + g * ds;
+        float* Sh = S + h * hd * ds;
+        for (size_t p = 0; p < hd; ++p) {
+            float* row = Sh + p * ds;
+            const float dx = dt * xh[p];
+            double acc = 0.0;
+            for (size_t n = 0; n < ds; ++n) {
+                row[n] = row[n] * dA + dx * B[n];
+                acc += static_cast<double>(row[n]) * C[n];
+            }
+            y[h * hd + p] = static_cast<float>(acc + static_cast<double>(D[h]) * xh[p]);
+        }
+    }
+    const size_t gw = di / ng;
+    for (size_t g = 0; g < ng; ++g) {
+        double ss = 0.0;
+        for (size_t i = g * gw; i < (g + 1) * gw; ++i) {
+            y[i] *= nh_silu(z[i]);
+            ss += static_cast<double>(y[i]) * y[i];
+        }
+        const double r = 1.0 / std::sqrt(ss / static_cast<double>(gw) + eps);
+        for (size_t i = g * gw; i < (g + 1) * gw; ++i) y[i] = static_cast<float>(y[i] * r * nw[i]);
+    }
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, nh_put_x(s, y.data(), di, k, act.map<uint8_t*>() + ax), ax);
+}
+
+void Core::nh_attn(const Step& s, int layer) {
+    // causal GQA attention for one token, NO positional encoding (transformers NemotronHAttention, llama.cpp
+    // nemotron-h build_attention_layer): q | k | v from the GEMV (f32 at a_y); the new [K | V] row (f32) at row
+    // pos_ of the layer's state; the output heads as the o GEMV's bf16 input (a_x)
+    const size_t nh = nh_sz(s, "heads"), kvh = nh_sz(s, "kv_heads"), hd = nh_sz(s, "head_dim");
+    const size_t ay = nh_sz(s, "a_y"), ax = nh_sz(s, "a_x"), k = nh_sz(s, "k");
+    const size_t qw = nh * hd, kvw = kvh * hd, grp = nh / kvh;
+    const LayerType& lt = *types_[layer];
+    if (lt.state_row != 2 * kvw * 4 || nh % kvh || k < qw)
+        throw std::runtime_error("open_qwen36: nh_attn: the KV row is not f32 [K | V]");
+    xrt::bo& act = act_[layer];
+    read_back(act, (qw + 2 * kvw) * 4, ay);
+    const float* q = reinterpret_cast<const float*>(act.map<uint8_t*>() + ay);
+    float* kv = state_[layer].map<float*>();
+    const size_t row = 2 * kvw, pos = static_cast<size_t>(pos_), L = pos + 1;
+    std::memcpy(kv + pos * row, q + qw, 2 * kvw * 4);            // K | V of this token
+    const float scale = 1.0f / std::sqrt(static_cast<float>(hd));
+    std::vector<float> og(qw);
+#pragma omp parallel
+    {
+        std::vector<double> sc(L);
+#pragma omp for schedule(static)
+        for (long long hh = 0; hh < static_cast<long long>(nh); ++hh) {
+            const size_t h = static_cast<size_t>(hh), g = h / grp;
+            const float* qh = q + h * hd;
+            double mx = -1e300;
+            for (size_t t = 0; t < L; ++t) {
+                const float* kt = kv + t * row + g * hd;
+                double d = 0.0;
+                for (size_t i = 0; i < hd; ++i) d += static_cast<double>(qh[i]) * kt[i];
+                sc[t] = d * scale;
+                mx = std::max(mx, sc[t]);
+            }
+            double sum = 0.0;
+            for (size_t t = 0; t < L; ++t) sum += (sc[t] = std::exp(sc[t] - mx));
+            std::vector<double> o(hd, 0.0);
+            for (size_t t = 0; t < L; ++t) {
+                const float* vt = kv + t * row + kvw + g * hd;
+                const double p = sc[t] / sum;
+                for (size_t i = 0; i < hd; ++i) o[i] += p * vt[i];
+            }
+            for (size_t i = 0; i < hd; ++i) og[h * hd + i] = static_cast<float>(o[i]);
+        }
+    }
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, nh_put_x(s, og.data(), qw, k, act.map<uint8_t*>() + ax), ax);
+}
+
+void Core::nh_route(const Step& s, int layer) {
+    // the expert block's input norm and router (transformers NemotronHTopkRouter with n_group 1, llama.cpp
+    // build_moe_ffn: sigmoid, exp_probs_b, norm_w, expert_weights_scale): xm = rms(x) * norm as nh_moe's bf16
+    // input; s = sigmoid(W xm) over the F32 router (xm in f32); the top k of s + bias (ties to the lower expert);
+    // weights the unbiased s of the chosen, renormalised, times scale; slots k.. are the shared expert's halves
+    // (pool experts E, E + 1, ...) at weight 1. The slots' up / down fills are re-pointed (`nhroute`).
+    const size_t hid = nh_sz(s, "hidden"), kp = nh_sz(s, "k"), E = nh_sz(s, "experts"), K = nh_sz(s, "topk");
+    const size_t slots = nh_sz(s, "slots"), axm = nh_sz(s, "a_xm"), aw = nh_sz(s, "a_w");
+    const uint64_t ups = static_cast<uint64_t>(nh_num(s, "ups")), dns = static_cast<uint64_t>(nh_num(s, "dns"));
+    const uint64_t pdown = static_cast<uint64_t>(nh_num(s, "pool_down"));
+    const double scale = nh_num(s, "scale"), eps = nh_num(s, "eps");
+    if (slots > 8 || K > slots || K > E) throw std::runtime_error("open_qwen36: nh_route geometry");
+    const std::vector<float>& nw = nh_tensor(nh_str(s, "norm"), layer, hid);
+    const std::vector<float>& wr = nh_tensor(nh_str(s, "router"), layer, E * hid);
+    const std::vector<float>& bias = nh_tensor(nh_str(s, "bias"), layer, E);
+    const float* x = buffer("xres", 0).map<float*>();
+    std::vector<float> xm(hid);
+    {
+        double ss = 0.0;
+        for (size_t i = 0; i < hid; ++i) ss += static_cast<double>(x[i]) * x[i];
+        const double r = 1.0 / std::sqrt(ss / static_cast<double>(hid) + eps);
+        for (size_t i = 0; i < hid; ++i) xm[i] = static_cast<float>(x[i] * r * nw[i]);
+    }
+    std::vector<double> sg(E), choice(E);
+#pragma omp parallel for schedule(static)
+    for (long long ee = 0; ee < static_cast<long long>(E); ++ee) {
+        const size_t e = static_cast<size_t>(ee);
+        const float* w = wr.data() + e * hid;
+        double a8[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+        size_t i = 0;
+        for (; i + 8 <= hid; i += 8)
+            for (size_t j = 0; j < 8; ++j) a8[j] += static_cast<double>(w[i + j]) * xm[i + j];
+        for (size_t j = 0; i < hid; ++i, ++j) a8[j] += static_cast<double>(w[i]) * xm[i];
+        const double lg = ((a8[0] + a8[1]) + (a8[2] + a8[3])) + ((a8[4] + a8[5]) + (a8[6] + a8[7]));
+        sg[e] = 1.0 / (1.0 + std::exp(-lg));
+        choice[e] = sg[e] + bias[e];
+    }
+    std::vector<uint32_t> order(E);
+    for (size_t e = 0; e < E; ++e) order[e] = static_cast<uint32_t>(e);
+    std::stable_sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b) { return choice[a] > choice[b]; });
+    uint32_t idx[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    float wv[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    double sum = 0.0;
+    for (size_t j = 0; j < K; ++j) sum += sg[order[j]];
+    for (size_t j = 0; j < K; ++j) {
+        idx[j] = order[j];
+        wv[j] = static_cast<float>(sg[order[j]] / sum * scale);
+    }
+    for (size_t j = K; j < slots; ++j) {
+        idx[j] = static_cast<uint32_t>(E + (j - K));
+        wv[j] = 1.0f;
+    }
+    xrt::bo& act = act_[layer];
+    uint8_t* a = act.map<uint8_t*>();
+    uint16_t* xb = reinterpret_cast<uint16_t*>(a + axm);
+    for (size_t i = 0; i < hid; ++i) xb[i] = f32_to_bf16(xm[i]);
+    for (size_t i = hid; i < kp; ++i) xb[i] = 0;
+    std::memcpy(a + aw, wv, sizeof wv);
+    if (aw < axm + kp * 2) throw std::runtime_error("open_qwen36: nh_route: the weights overlap xm");
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, aw + sizeof wv - axm, axm);
+    if (route_log_on_) {
+        std::vector<uint8_t> rec(sizeof idx + sizeof wv);
+        std::memcpy(rec.data(), idx, sizeof idx);
+        std::memcpy(rec.data() + sizeof idx, wv, sizeof wv);
+        route_log_.push_back({layer, rec});
+    }
+    // the slots' fills: compiled as pool experts 0..slots-1 (up at j ups, down at pool_down + j dns)
+    Kern& k = kerns_.at(s.kernel);
+    if (k.moe2.empty()) {
+        const std::vector<uint32_t>& w = k.words;
+        size_t nup = 0, ndn = 0;
+        for (size_t i = 4; i < w.size(); i += stream_patch::op_len(w[i])) {
+            if (w[i] != 0x81 || i + 11 >= w.size() || w[i + 8] != 0) continue;
+            const uint64_t off = w[i + 10];
+            if (off < pdown) {
+                if (off / ups < slots) { k.moe2.push_back({i + 10, static_cast<size_t>(off / ups), 0, 0, off % ups}); ++nup; }
+            } else if ((off - pdown) / dns < slots) {
+                k.moe2.push_back({i + 10, static_cast<size_t>((off - pdown) / dns) | 0x100, 0, 0, (off - pdown) % dns});
+                ++ndn;
+            }
+        }
+        if (!nup || !ndn)
+            throw std::runtime_error("open_qwen36: nhroute: " + k.name + " has " + std::to_string(nup) + " up and " +
+                                     std::to_string(ndn) + " down expert fills");
+        log("nhroute " + k.name + ": " + std::to_string(nup) + " up / " + std::to_string(ndn) + " down fills");
+    }
+    for (size_t j = 0; j < slots; ++j)
+        if (idx[j] >= E + (slots - K)) throw std::runtime_error("open_qwen36: nh_route: expert " + std::to_string(idx[j]));
+    uint32_t* iw = k.iw();
+    for (const auto& p : k.moe2) {
+        const uint64_t e = idx[p.slot & 0xff];
+        const uint64_t v = (p.slot & 0x100) == 0 ? e * ups + p.intra : pdown + e * dns + p.intra;
+        if (v >> 32) throw std::runtime_error("open_qwen36: nhroute: a fill past a 32-bit offset");
+        iw[p.word] = static_cast<uint32_t>(v);
+    }
+    k.instr->sync(XCL_BO_SYNC_BO_TO_DEVICE);
+}
+
