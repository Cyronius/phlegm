+    // contiguous here, one row of the GEMM output each
+    constexpr size_t TK = 64, MAC = 8, TN = 32;
+    if (K % TK || T % TN) throw std::runtime_error("open_qwen36: act_tile: K or T does not tile by (64, 32)");
+    const size_t NB = T / TN;
