+// ---- kind "lfm": LFM2-MoE's block layer (OPEN-FAMILY-LFM2MOE, recipes/lfm2moe.py gemm_route; the mixer's GEMMs on the
+// NPU, the conv / attention middle and the norms on the host, the leading dense layers' two MLP GEMMs or the host
+// router and the token-batched experts)
+void Core::lfm_route_rows(int l, const float* xm, size_t t_real, int32_t* idx, float* wout) {
+    const GemmBlockProgram& gb = types_[l]->gemm_block;
+    const size_t hid = w_->hidden, E = gb.route_experts, K = gb.route_topk;
+    auto it = hy_router_.find(l);
+    if (it == hy_router_.end()) {
+        auto name = [&](std::string n) {
+            for (size_t p = n.find("{l}"); p != std::string::npos; p = n.find("{l}")) n.replace(p, 3, std::to_string(l));
+            return n;
+        };
+        std::vector<float> w = file_->f32(name(gb.route_router)), b = file_->f32(name(gb.route_bias));
+        if (w.size() != E * hid || b.size() != E)
+            throw std::runtime_error("open_qwen36: layer " + std::to_string(l) + ": the router is not [" + std::to_string(E) + ", " +
+                                     std::to_string(hid) + "] with a [" + std::to_string(E) + "] bias");
+        it = hy_router_.emplace(l, std::make_pair(std::move(w), std::move(b))).first;
+    }
+    const std::vector<float>& W = it->second.first;
+    const std::vector<float>& B = it->second.second;
+#pragma omp parallel for
+    for (long long tt = 0; tt < static_cast<long long>(t_real); ++tt) {
+        const size_t t = static_cast<size_t>(tt);
+        std::vector<double> x(hid), score(E), choice(E);
+        for (size_t i = 0; i < hid; ++i) x[i] = bf16_to_f32(f32_to_bf16(xm[t * hid + i]));
+        for (size_t e = 0; e < E; ++e) {
+            const float* wr = W.data() + e * hid;
+            double acc = 0.0;
+            for (size_t i = 0; i < hid; ++i) acc += static_cast<double>(wr[i]) * x[i];
+            score[e] = 1.0 / (1.0 + std::exp(-acc));
+            choice[e] = score[e] + static_cast<double>(B[e]);
+        }
+        std::vector<uint32_t> order(E);
+        for (size_t e = 0; e < E; ++e) order[e] = static_cast<uint32_t>(e);
+        std::stable_sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b) { return choice[a] > choice[b]; });
+        double sum = 0.0;
+        for (size_t j = 0; j < K; ++j) sum += score[order[j]];
+        for (size_t j = 0; j < K; ++j) {
+            idx[t * K + j] = static_cast<int32_t>(order[j]);
+            wout[t * K + j] = static_cast<float>(score[order[j]] / (sum + 1e-20) * gb.route_scale);
+        }
+    }
