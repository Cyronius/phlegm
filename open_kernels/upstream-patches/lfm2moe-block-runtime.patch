+    if (!moe_batch_on_) throw std::runtime_error("open_qwen36: the lfm route has no per-token expert fallback (OFLM_OPEN_MOE_BATCH=0)");
+    moe_block(l, xm, res, moe_.idx.data(), moe_.w.data(), T, t_real, xres);
