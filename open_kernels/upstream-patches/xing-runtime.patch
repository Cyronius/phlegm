+// ============================================================================
+// Xing 4.0 (OPEN-FAMILY-XING, open_kernels/recipes/xing.py; xing-runtime.patch). A DeepSeek-V3 decoder whose
+// residual is DeepSeek's mHC: `hc` f32 streams of [hidden] in the xres global's host map (the embedding lands in
+// stream 0; layer 0's first step copies it to the others). Around every sublayer: xg_pre (the streams' rms, the
+// 24 mixes through hc_fn, pre / post / the Sinkhorn comb, the collapsed input and its norm) and xg_post (S_i <-
+// post_i y + sum_j comb_ij S_j). The NPU runs the projection GEMVs and the gated expert program; xg_qnorm and
+// xg_mla are the MLA glue: the q / kv norms, RoPE, the layer's KV row [latent | rope key] (f32, in its state BO,
+// host side), the absorbed attention (q_nope through attn_k_b into the latent, the output through attn_v_b).
+// The arithmetic is the Hub's modeling_xing4_0.py @ ac0fc307 (llama.cpp src/models/xing4-0.cpp agrees).
+// ============================================================================
+
+namespace {
+double xg_sigmoid(double v) { return 1.0 / (1.0 + std::exp(-v)); }
+/// pairs (2i, 2i + 1) of v[0..2 half) turned by pos * inv[i] (HF rope_interleave, llama.cpp's normal RoPE)
+void xg_rope(float* v, size_t half, double pos, const std::vector<double>& inv) {
+    for (size_t i = 0; i < half; ++i) {
+        const double a = pos * inv[i], c = std::cos(a), sn = std::sin(a);
+        const double x0 = v[2 * i], x1 = v[2 * i + 1];
+        v[2 * i] = static_cast<float>(x0 * c - x1 * sn);
+        v[2 * i + 1] = static_cast<float>(x0 * sn + x1 * c);
+    }
+}
+/// rms(x[0..n)) * w as f32 into dst, the mean in double
+void xg_rms(const float* x, const float* w, size_t n, double eps, float* dst) {
+    double ss = 0.0;
+    for (size_t i = 0; i < n; ++i) ss += static_cast<double>(x[i]) * x[i];
+    const double r = 1.0 / std::sqrt(ss / static_cast<double>(n) + eps);
+    for (size_t i = 0; i < n; ++i) dst[i] = static_cast<float>(x[i] * r * w[i]);
+}
+}  // namespace
+
+const std::vector<float>& Core::xg_tensor(const std::string& pattern, int layer, size_t n) {
+    std::string name = pattern;
+    const size_t at = name.find("{l}");
+    if (at != std::string::npos) name.replace(at, 3, std::to_string(layer));
+    auto it = nh_w_.find(name);
+    if (it != nh_w_.end()) return it->second;
+    const GgufFile* g = dynamic_cast<const GgufFile*>(file_.get());
+    if (!g) throw std::runtime_error("open_qwen36: xg_tensor " + name + ": a GGUF-only step");
+    const GgufFile::TensorInfo& t = g->tensor(name);
+    const size_t nv = static_cast<size_t>(t.nvalues());
+    if (n && nv != n)
+        throw std::runtime_error("open_qwen36: " + name + " has " + std::to_string(nv) + " values, the step wants " +
+                                 std::to_string(n));
+    size_t nb = 0;
+    const uint8_t* p = g->raw(name, &nb);
+    std::vector<float> v(nv);
+    auto f16 = [](const uint8_t* b) { uint16_t h; std::memcpy(&h, b, 2); return fp16_to_f32(h); };
+    switch (t.type) {
+        case GgufFile::Type::F32:
+            if (nb < nv * 4) throw std::runtime_error("open_qwen36: " + name + " is short");
+            std::memcpy(v.data(), p, nv * 4);
+            break;
+        case GgufFile::Type::F16:
+            for (size_t i = 0; i < nv; ++i) v[i] = f16(p + 2 * i);
+            break;
+        case GgufFile::Type::BF16:
+            for (size_t i = 0; i < nv; ++i) { uint16_t u; std::memcpy(&u, p + 2 * i, 2); v[i] = bf16_to_f32(u); }
+            break;
+        case GgufFile::Type::Q4_0:
+            if (nv % 32 || nb < nv / 32 * 18) throw std::runtime_error("open_qwen36: " + name + " is not whole Q4_0 blocks");
+            for (size_t b = 0; b < nv / 32; ++b) {
+                const uint8_t* q = p + b * 18;
+                const float d = f16(q);
+                for (size_t i = 0; i < 16; ++i) {
+                    v[b * 32 + i] = d * static_cast<float>((q[2 + i] & 15) - 8);
+                    v[b * 32 + 16 + i] = d * static_cast<float>((q[2 + i] >> 4) - 8);
+                }
+            }
+            break;
+        case GgufFile::Type::Q8_0:
+            if (nv % 32 || nb < nv / 32 * 34) throw std::runtime_error("open_qwen36: " + name + " is not whole Q8_0 blocks");
+            for (size_t b = 0; b < nv / 32; ++b) {
+                const uint8_t* q = p + b * 34;
+                const float d = f16(q);
+                for (size_t i = 0; i < 32; ++i) v[b * 32 + i] = d * static_cast<float>(static_cast<int8_t>(q[2 + i]));
+            }
+            break;
+        default:
+            throw std::runtime_error("open_qwen36: xg_tensor " + name + ": type " + GgufFile::type_name(t.type));
+    }
+    return nh_w_.emplace(name, std::move(v)).first->second;
+}
+
+void Core::xg_step(const Step& s, int layer) {
+    auto t0 = std::chrono::steady_clock::now();
+    if (s.op == "xg_pre") xg_pre(s, layer);
+    else if (s.op == "xg_qnorm") xg_qnorm(s, layer);
+    else if (s.op == "xg_mla") xg_mla(s, layer);
+    else if (s.op == "xg_post") xg_post(s, layer);
+    else if (s.op == "xg_final") xg_final(s);
+    else throw std::runtime_error("open_qwen36: unknown host step " + s.op);
+    timing_.route_ms += ms_since(t0);
+}
+
+void Core::xg_pre(const Step& s, int layer) {
+    // mHC pre (Xing4_0HyperConnection): f = the streams flattened stream-major, / rms (eps); m = f hc_fn^T [24];
+    // pre = sigmoid(m[0:4] s0 + b), post = 2 sigmoid(m[4:8] s1 + b), comb = Sinkhorn(exp(clamp(m[8:24] s2 + b)
+    // - rowmax)) with `hc_iters` (row / (sum + eps), then column) normalisations; h = sum_i pre_i S_i; then the
+    // sublayer's norm: mode x -> f32 at a_x (the GEMV's x); route / dense -> bf16 xm at a_xm and the slots'
+    // weights f32[16] at a_w (route: the sigmoid router, the top k of s + bias, the unbiased s renormalised x
+    // scale, slot topk the shared expert at 1, the fills re-pointed; dense: every slot at 1)
+    const size_t hid = nh_sz(s, "hidden"), hc = nh_sz(s, "hc"), k = nh_sz(s, "k");
+    const size_t mix = (2 + hc) * hc;
+    const std::string& mode = nh_str(s, "mode");
+    if (hc != 4) throw std::runtime_error("open_qwen36: xg_pre: " + std::to_string(hc) + " streams (4 are held)");
+    const double eps = nh_num(s, "eps"), heps = nh_num(s, "hc_eps"), clamp = nh_num(s, "hc_clamp");
+    const size_t iters = nh_sz(s, "hc_iters");
+    const std::vector<float>& fn = xg_tensor(nh_str(s, "hc_fn"), layer, mix * hc * hid);
+    const std::vector<float>& base = xg_tensor(nh_str(s, "hc_base"), layer, mix);
+    const std::vector<float>& sc = xg_tensor(nh_str(s, "hc_scale"), layer, 3);
+    const std::vector<float>& nw = nh_tensor(nh_str(s, "norm"), layer, hid);
+    xrt::bo& xb = buffer("xres", 0);
+    if (xb.size() < hc * hid * 4) throw std::runtime_error("open_qwen36: xg_pre: xres holds fewer than 4 streams");
+    float* S = xb.map<float*>();
+    if (layer == 0 && mode == "x")                                    // the embedding (stream 0) into every stream
+        for (size_t i = 1; i < hc; ++i) std::memcpy(S + i * hid, S, hid * 4);
+    const size_t n = hc * hid;
+    if (n % 8) throw std::runtime_error("open_qwen36: xg_pre: the streams are not whole 8-value groups");
+    double ss = 0.0;
+    for (size_t i = 0; i < n; ++i) ss += static_cast<double>(S[i]) * S[i];
+    const double r = 1.0 / std::sqrt(ss / static_cast<double>(n) + eps);
+    double m[24];
+#pragma omp parallel for schedule(static)
+    for (long long jj = 0; jj < static_cast<long long>(mix); ++jj) {
+        const float* w = fn.data() + static_cast<size_t>(jj) * n;
+        double a8[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+        for (size_t i = 0; i < n; i += 8)
+            for (size_t j = 0; j < 8; ++j) a8[j] += static_cast<double>(w[i + j]) * S[i + j];
+        m[jj] = (((a8[0] + a8[1]) + (a8[2] + a8[3])) + ((a8[4] + a8[5]) + (a8[6] + a8[7]))) * r;
+    }
+    double pre[4], cm[16];
+    for (size_t i = 0; i < hc; ++i) {
+        pre[i] = xg_sigmoid(m[i] * sc[0] + base[i]);
+        xg_post_[i] = 2.0 * xg_sigmoid(m[hc + i] * sc[1] + base[hc + i]);
+    }
+    for (size_t i = 0; i < hc; ++i) {
+        double mx = -1e300;
+        for (size_t j = 0; j < hc; ++j) {
+            double v = m[2 * hc + i * hc + j] * sc[2] + base[2 * hc + i * hc + j];
+            v = std::min(std::max(v, -clamp), clamp);
+            cm[i * hc + j] = v;
+            mx = std::max(mx, v);
+        }
+        for (size_t j = 0; j < hc; ++j) cm[i * hc + j] = std::exp(cm[i * hc + j] - mx);
+    }
+    for (size_t it = 0; it < iters; ++it) {
+        for (size_t i = 0; i < hc; ++i) {
+            double t = 0.0;
+            for (size_t j = 0; j < hc; ++j) t += cm[i * hc + j];
+            for (size_t j = 0; j < hc; ++j) cm[i * hc + j] /= t + heps;
+        }
+        for (size_t j = 0; j < hc; ++j) {
+            double t = 0.0;
+            for (size_t i = 0; i < hc; ++i) t += cm[i * hc + j];
+            for (size_t i = 0; i < hc; ++i) cm[i * hc + j] /= t + heps;
+        }
+    }
+    std::memcpy(xg_comb_, cm, sizeof cm);
+    std::vector<float> h(hid), hn(hid);
+    for (size_t d = 0; d < hid; ++d) {
+        double a = 0.0;
+        for (size_t i = 0; i < hc; ++i) a += pre[i] * S[i * hid + d];
+        h[d] = static_cast<float>(a);
+    }
+    xg_rms(h.data(), nw.data(), hid, eps, hn.data());
+    xrt::bo& act = act_[layer];
+    uint8_t* a = act.map<uint8_t*>();
+    if (mode == "x") {
+        const size_t ax = nh_sz(s, "a_x");
+        if (k < hid) throw std::runtime_error("open_qwen36: xg_pre: K under hidden");
+        float* o = reinterpret_cast<float*>(a + ax);
+        std::memcpy(o, hn.data(), hid * 4);
+        for (size_t i = hid; i < k; ++i) o[i] = 0.0f;
+        act.sync(XCL_BO_SYNC_BO_TO_DEVICE, k * 4, ax);
+        return;
+    }
+    const size_t axm = nh_sz(s, "a_xm"), aw = nh_sz(s, "a_w"), slots = nh_sz(s, "slots");
+    if (slots > 16 || aw < axm + k * 2) throw std::runtime_error("open_qwen36: xg_pre: the slot record geometry");
+    uint32_t idx[16] = {};
+    float wv[16] = {};
+    if (mode == "dense") {
+        for (size_t j = 0; j < slots; ++j) { idx[j] = static_cast<uint32_t>(j); wv[j] = 1.0f; }
+    } else if (mode == "route") {
+        const size_t E = nh_sz(s, "experts"), K = nh_sz(s, "topk");
+        if (K + 1 != slots || K > E) throw std::runtime_error("open_qwen36: xg_pre route: top-k + 1 shared != slots");
+        const std::vector<float>& wr = xg_tensor(nh_str(s, "router"), layer, E * hid);
+        const std::vector<float>& bias = xg_tensor(nh_str(s, "bias"), layer, E);
+        const double scale = nh_num(s, "scale");
+        std::vector<double> sg(E), choice(E);
+#pragma omp parallel for schedule(static)
+        for (long long ee = 0; ee < static_cast<long long>(E); ++ee) {
+            const size_t e = static_cast<size_t>(ee);
+            const float* w = wr.data() + e * hid;
+            double a8[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+            size_t i = 0;
+            for (; i + 8 <= hid; i += 8)
+                for (size_t j = 0; j < 8; ++j) a8[j] += static_cast<double>(w[i + j]) * hn[i + j];
+            for (size_t j = 0; i < hid; ++i, ++j) a8[j] += static_cast<double>(w[i]) * hn[i];
+            const double lg = ((a8[0] + a8[1]) + (a8[2] + a8[3])) + ((a8[4] + a8[5]) + (a8[6] + a8[7]));
+            sg[e] = xg_sigmoid(lg);
+            choice[e] = sg[e] + bias[e];
+        }
+        std::vector<uint32_t> order(E);
+        for (size_t e = 0; e < E; ++e) order[e] = static_cast<uint32_t>(e);
+        std::stable_sort(order.begin(), order.end(), [&](uint32_t x, uint32_t y) { return choice[x] > choice[y]; });
+        double sum = 0.0;
+        for (size_t j = 0; j < K; ++j) sum += sg[order[j]];
+        for (size_t j = 0; j < K; ++j) {
+            idx[j] = order[j];
+            wv[j] = static_cast<float>(sg[order[j]] / (sum + 1e-20) * scale);
+        }
+        idx[K] = static_cast<uint32_t>(E);                        // the shared expert, pool expert E
+        wv[K] = 1.0f;
+    } else {
+        throw std::runtime_error("open_qwen36: xg_pre: unknown mode " + mode);
+    }
+    uint16_t* xm = reinterpret_cast<uint16_t*>(a + axm);
+    for (size_t i = 0; i < hid; ++i) xm[i] = f32_to_bf16(hn[i]);
+    for (size_t i = hid; i < k; ++i) xm[i] = 0;
+    std::memcpy(a + aw, wv, sizeof wv);
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, aw + sizeof wv - axm, axm);
+    if (route_log_on_) {
+        std::vector<uint8_t> rec(sizeof idx + sizeof wv);
+        std::memcpy(rec.data(), idx, sizeof idx);
+        std::memcpy(rec.data() + sizeof idx, wv, sizeof wv);
+        route_log_.push_back({layer, rec});
+    }
+    if (mode != "route") return;                                     // dense: slot j is compiled at slice j
+    // the slots' fills: compiled as pool experts 0..slots-1 (gate | up at pool_exp + j ups, down at pool_down + j dns)
+    const size_t E = nh_sz(s, "experts");
+    const uint64_t ups = static_cast<uint64_t>(nh_num(s, "ups")), dns = static_cast<uint64_t>(nh_num(s, "dns"));
+    const uint64_t pexp = static_cast<uint64_t>(nh_num(s, "pool_exp")), pdown = static_cast<uint64_t>(nh_num(s, "pool_down"));
+    Kern& kk = kerns_.at(s.kernel);
+    if (kk.moe2.empty()) {
+        const std::vector<uint32_t>& w = kk.words;
+        size_t nup = 0, ndn = 0;
+        for (size_t i = 4; i < w.size(); i += stream_patch::op_len(w[i])) {
+            if (w[i] != 0x81 || i + 11 >= w.size() || w[i + 8] != 0) continue;
+            const uint64_t off = w[i + 10];
+            if (off >= pexp && off < pdown) {
+                if ((off - pexp) / ups < slots) {
+                    kk.moe2.push_back({i + 10, static_cast<size_t>((off - pexp) / ups), 0, 0, (off - pexp) % ups});
+                    ++nup;
+                }
+            } else if (off >= pdown && (off - pdown) / dns < slots) {
+                kk.moe2.push_back({i + 10, static_cast<size_t>((off - pdown) / dns) | 0x100, 0, 0, (off - pdown) % dns});
+                ++ndn;
+            }
+        }
+        if (!nup || !ndn)
+            throw std::runtime_error("open_qwen36: nhroute: " + kk.name + " has " + std::to_string(nup) + " gate|up and " +
+                                     std::to_string(ndn) + " down expert fills");
+        log("nhroute " + kk.name + ": " + std::to_string(nup) + " gate|up / " + std::to_string(ndn) + " down fills");
+    }
+    for (size_t j = 0; j < slots; ++j)
+        if (idx[j] > E) throw std::runtime_error("open_qwen36: xg_pre: expert " + std::to_string(idx[j]));
+    uint32_t* iw = kk.iw();
+    for (const auto& p : kk.moe2) {
+        const uint64_t e = idx[p.slot & 0xff];
+        const uint64_t v = (p.slot & 0x100) == 0 ? pexp + e * ups + p.intra : pdown + e * dns + p.intra;
+        if (v >> 32) throw std::runtime_error("open_qwen36: nhroute: a fill past a 32-bit offset");
+        iw[p.word] = static_cast<uint32_t>(v);
+    }
+    kk.instr->sync(XCL_BO_SYNC_BO_TO_DEVICE);
+}
+
+void Core::xg_post(const Step& s, int layer) {
+    // S_i <- post_i y + sum_j comb_ij S_j, y the sublayer's f32 [hidden] at a_o (the last xg_pre's post / comb)
+    const size_t hid = nh_sz(s, "hidden"), hc = nh_sz(s, "hc"), ao = nh_sz(s, "a_o");
+    if (hc != 4) throw std::runtime_error("open_qwen36: xg_post: 4 streams are held");
+    xrt::bo& act = act_[layer];
+    read_back(act, hid * 4, ao);
+    const float* y = reinterpret_cast<const float*>(act.map<uint8_t*>() + ao);
+    float* S = buffer("xres", 0).map<float*>();
+#pragma omp parallel for schedule(static)
+    for (long long dd = 0; dd < static_cast<long long>(hid); ++dd) {
+        const size_t d = static_cast<size_t>(dd);
+        double old[4], nw[4];
+        for (size_t j = 0; j < 4; ++j) old[j] = S[j * hid + d];
+        for (size_t i = 0; i < 4; ++i) {
+            double a = xg_post_[i] * y[d];
+            for (size_t j = 0; j < 4; ++j) a += xg_comb_[i * 4 + j] * old[j];
+            nw[i] = a;
+        }
+        for (size_t i = 0; i < 4; ++i) S[i * hid + d] = static_cast<float>(nw[i]);
+    }
+}
+
+void Core::xg_qnorm(const Step& s, int layer) {
+    // the q_a | kv_a GEMV's [q_lora | kv_lora | rope] (f32 at a_y): q_a_norm -> the q_b GEMV's f32 x (a_x);
+    // kv_a_norm on the latent and RoPE on the key's rope part -> the layer's KV row [latent | rope] at row pos_
+    const size_t ql = nh_sz(s, "q_lora"), kvl = nh_sz(s, "kv_lora"), rot = nh_sz(s, "rope");
+    const size_t ay = nh_sz(s, "a_y"), ax = nh_sz(s, "a_x"), k = nh_sz(s, "k");
+    const double eps = nh_num(s, "eps");
+    const LayerType& lt = *types_[layer];
+    if (lt.state_row != (kvl + rot) * 4 || k < ql || rot / 2 > w_->rope_inv_freq.size())
+        throw std::runtime_error("open_qwen36: xg_qnorm: the KV row is not f32 [latent | rope]");
+    const std::vector<float>& qw = nh_tensor(nh_str(s, "q_norm"), layer, ql);
+    const std::vector<float>& kw = nh_tensor(nh_str(s, "kv_norm"), layer, kvl);
+    xrt::bo& act = act_[layer];
+    read_back(act, (ql + kvl + rot) * 4, ay);
+    uint8_t* a = act.map<uint8_t*>();
+    const float* y = reinterpret_cast<const float*>(a + ay);
+    float* row = state_[layer].map<float*>() + static_cast<size_t>(pos_) * (kvl + rot);
+    std::vector<float> qa(ql);
+    xg_rms(y, qw.data(), ql, eps, qa.data());
+    xg_rms(y + ql, kw.data(), kvl, eps, row);
+    std::memcpy(row + kvl, y + ql + kvl, rot * 4);
+    xg_rope(row + kvl, rot / 2, static_cast<double>(pos_), w_->rope_inv_freq);
+    float* o = reinterpret_cast<float*>(a + ax);
+    std::memcpy(o, qa.data(), ql * 4);
+    for (size_t i = ql; i < k; ++i) o[i] = 0.0f;
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, k * 4, ax);
+}
+
+void Core::xg_mla(const Step& s, int layer) {
+    // the absorbed MLA attention for one token (DeepSeek-V2's MQA form; llama.cpp xing4-0.cpp): q [heads][nope |
+    // rope] from the q_b GEMV (f32 at a_y); per head: q_rope turned at pos_, q_lat = k_b[h] q_nope (kv_lora), the
+    // scores (q_lat . c_t + q_rope . r_t) * scale over the KV rows 0..pos_, softmax, ctx = sum_t p_t c_t, out =
+    // v_b[h] ctx (v_dim) -> the o GEMV's f32 x (a_x)
+    const size_t nh = nh_sz(s, "heads"), nope = nh_sz(s, "nope"), rot = nh_sz(s, "rope"), vd = nh_sz(s, "v_dim");
+    const size_t kvl = nh_sz(s, "kv_lora"), ay = nh_sz(s, "a_y"), ax = nh_sz(s, "a_x"), k = nh_sz(s, "k");
+    const double scale = nh_num(s, "scale");
+    const size_t qd = nope + rot, row = kvl + rot;
+    const LayerType& lt = *types_[layer];
+    if (lt.state_row != row * 4 || k < nh * vd) throw std::runtime_error("open_qwen36: xg_mla: the KV row geometry");
+    const std::vector<float>& kb = xg_tensor(nh_str(s, "k_b"), layer, nh * kvl * nope);   // [h][kvl][nope]
+    const std::vector<float>& vb = xg_tensor(nh_str(s, "v_b"), layer, nh * vd * kvl);     // [h][vd][kvl]
+    xrt::bo& act = act_[layer];
+    read_back(act, nh * qd * 4, ay);
+    uint8_t* a = act.map<uint8_t*>();
+    const float* q = reinterpret_cast<const float*>(a + ay);
+    const float* kv = state_[layer].map<float*>();
+    const size_t L = static_cast<size_t>(pos_) + 1;
+    std::vector<float> out(nh * vd);
+#pragma omp parallel
+    {
+        std::vector<double> sc(L), lat(kvl), ctx(kvl);
+        std::vector<float> qr(rot);
+#pragma omp for schedule(static)
+        for (long long hh = 0; hh < static_cast<long long>(nh); ++hh) {
+            const size_t h = static_cast<size_t>(hh);
+            const float* qh = q + h * qd;
+            std::memcpy(qr.data(), qh + nope, rot * 4);
+            xg_rope(qr.data(), rot / 2, static_cast<double>(pos_), w_->rope_inv_freq);
+            const float* kbh = kb.data() + h * kvl * nope;
+            for (size_t r = 0; r < kvl; ++r) {
+                double acc = 0.0;
+                for (size_t i = 0; i < nope; ++i) acc += static_cast<double>(kbh[r * nope + i]) * qh[i];
+                lat[r] = acc;
+            }
+            double mx = -1e300;
+            for (size_t t = 0; t < L; ++t) {
+                const float* ct = kv + t * row;
+                double d = 0.0;
+                for (size_t r = 0; r < kvl; ++r) d += lat[r] * ct[r];
+                for (size_t i = 0; i < rot; ++i) d += static_cast<double>(qr[i]) * ct[kvl + i];
+                sc[t] = d * scale;
+                mx = std::max(mx, sc[t]);
+            }
+            double sum = 0.0;
+            for (size_t t = 0; t < L; ++t) sum += (sc[t] = std::exp(sc[t] - mx));
+            std::fill(ctx.begin(), ctx.end(), 0.0);
+            for (size_t t = 0; t < L; ++t) {
+                const float* ct = kv + t * row;
+                const double p = sc[t] / sum;
+                for (size_t r = 0; r < kvl; ++r) ctx[r] += p * ct[r];
+            }
+            const float* vbh = vb.data() + h * vd * kvl;
+            for (size_t j = 0; j < vd; ++j) {
+                double acc = 0.0;
+                for (size_t r = 0; r < kvl; ++r) acc += static_cast<double>(vbh[j * kvl + r]) * ctx[r];
+                out[h * vd + j] = static_cast<float>(acc);
+            }
+        }
+    }
+    float* o = reinterpret_cast<float*>(a + ax);
+    std::memcpy(o, out.data(), nh * vd * 4);
+    for (size_t i = nh * vd; i < k; ++i) o[i] = 0.0f;
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, k * 4, ax);
+}
+
+void Core::xg_final(const Step& s) {
+    // the streams' mean, then output_norm -> the head's bf16 input
+    const size_t hid = nh_sz(s, "hidden"), hc = nh_sz(s, "hc"), k = nh_sz(s, "k");
+    const std::vector<float>& w = nh_tensor(nh_str(s, "norm"), 0, hid);
+    const float* S = buffer("xres", 0).map<float*>();
+    std::vector<float> mean(hid);
+    for (size_t d = 0; d < hid; ++d) {
+        double a = 0.0;
+        for (size_t i = 0; i < hc; ++i) a += S[i * hid + d];
+        mean[d] = static_cast<float>(a / static_cast<double>(hc));
+    }
+    xrt::bo& hn = buffer(nh_str(s, "dst"), 0);
+    if (hn.size() < k * 2) throw std::runtime_error("open_qwen36: xg_final: the head input is smaller than K");
+    nh_rms_bf16(mean.data(), w.data(), hid, k, nh_num(s, "eps"), hn.map<uint16_t*>());
+    hn.sync(XCL_BO_SYNC_BO_TO_DEVICE, k * 2, 0);
+}
