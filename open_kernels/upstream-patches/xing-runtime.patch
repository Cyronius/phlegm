diff -ruN --suppress-blank-empty patch-a/src/open_qwen36/xing_pack_check.cpp patch-b/src/open_qwen36/xing_pack_check.cpp
--- a/src/open_qwen36/xing_pack_check.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/open_qwen36/xing_pack_check.cpp	2026-11-08 09:49:17.832980690 -0600
@@ -0,0 +1,152 @@
+// xing_pack_check: Xing 4.0's packing on the CPU, no NPU (OPEN-FAMILY-XING, xing-runtime.patch). Loads the kernel
+// set's manifest (its gguf view), checks the model's config against it, packs the layers named and the head, and
+// reads random weights back out of the pools through the Q4_0-native chunk law (band_stride included: the gate |
+// up interleave) and the head's f32-scale q8 law, against the GGUF's own blocks: every routed expert, the shared
+// expert, the dense MLP's slices and their down column windows. It also checks that the host steps' tensors exist
+// with the values their steps want. With a sample file it writes every sample (tensor, file row, file column,
+// pool value) for open_kernels/model/xing_gguf_check.py, which reads them against gguf-py's dequantization.
+//   xing_pack_check <kernel dir> <model dir> [samples] [layers, comma-separated] [sample file]
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <random>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "open_qwen36/gguf_file.hpp"
+#include "open_qwen36/manifest.hpp"
+#include "open_qwen36/pools.hpp"
+
+using namespace open_qwen36;
+
+namespace {
+float bf(uint16_t u) { uint32_t x = static_cast<uint32_t>(u) << 16; float f; std::memcpy(&f, &x, 4); return f; }
+float h2f(uint16_t h) {
+    const uint32_t s = (h >> 15) & 1, e = (h >> 10) & 31, m = h & 1023;
+    float v = e == 0 ? std::ldexp(static_cast<float>(m), -24) : std::ldexp(static_cast<float>(m | 1024), static_cast<int>(e) - 25);
+    return s ? -v : v;
+}
+/// value (r, k) of a [rows, K] Q4_0-native band-law matrix at `base`, band b at b * bstride
+float pool_q40(const uint8_t* base, size_t K, size_t bstride, size_t r, size_t k) {
+    const size_t band = r / 64, part = (r % 64) / 32, rr = r % 32, kt = k / 256, kin = k % 256;
+    const uint8_t* c = base + band * bstride + (kt * 2 + part) * 4608;
+    uint16_t d;
+    std::memcpy(&d, c + 2 * ((kin / 32) * 32 + rr), 2);
+    const size_t p = (rr / 16) * 4096 + kin * 16 + rr % 16;
+    const uint8_t byte = c[512 + (p >> 1)];
+    const int q = (p & 1) ? byte >> 4 : byte & 15;
+    return bf(d) * static_cast<float>(q - 8);
+}
+/// value (r, k) of a Q4_0 GGUF [rows, cols] tensor (its row r of a flattened [.., rows, cols])
+float file_q40(const uint8_t* src, size_t cols, size_t r, size_t k) {
+    const uint8_t* b = src + (r * (cols / 32) + k / 32) * 18;
+    uint16_t d;
+    std::memcpy(&d, b, 2);
+    const size_t i = k % 32;
+    const int q = i < 16 ? (b[2 + i] & 15) : (b[2 + i - 16] >> 4);
+    return h2f(d) * static_cast<float>(q - 8);
+}
+int fails = 0;
+void expect(bool ok, const std::string& what) {
+    if (!ok && fails++ < 20) std::fprintf(stderr, "MISMATCH %s\n", what.c_str());
+}
+std::string at_layer(std::string s, int layer) {
+    const size_t at = s.find("{l}");
+    if (at != std::string::npos) s.replace(at, 3, std::to_string(layer));
+    return s;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::fprintf(stderr, "usage: %s <kernel dir> <model dir> [samples] [layers] [sample file]\n", argv[0]);
+        return 2;
+    }
+    const std::string kd = argv[1], md = argv[2];
+    const int samples = argc > 3 ? std::atoi(argv[3]) : 4000;
+    std::vector<int> layers = {0, 1, 2, 39};
+    if (argc > 4) {
+        layers.clear();
+        std::stringstream ss(argv[4]);
+        for (std::string t; std::getline(ss, t, ',');) layers.push_back(std::atoi(t.c_str()));
+    }
+    std::FILE* out = argc > 5 ? std::fopen(argv[5], "w") : nullptr;
+    Manifest man = Manifest::load(kd + "/manifest.json");
+    const Manifest& w = *man.gguf;
+    GgufFile f(md + "/model.gguf");
+    std::ifstream cf(md + "/config.json");
+    nlohmann::json j = nlohmann::json::parse(cf);
+    w.check_model(j, "model");
+    std::printf("manifest ok: %zu layers, %zu layer types, chunk %zu\n", w.layers.size(), w.layer_types.size(), w.chunk_bytes);
+    std::mt19937_64 rng(7);
+    for (int layer : layers) {
+        if (layer < 0 || static_cast<size_t>(layer) >= w.layers.size()) { std::fprintf(stderr, "no layer %d\n", layer); return 2; }
+        const LayerType& lt = w.layer_type(static_cast<size_t>(layer));
+        const size_t bytes = lt.pool_bytes ? lt.pool_bytes : w.pool_bytes;
+        std::vector<uint8_t> pool(bytes);
+        pools::pack_pool(w, lt, f, layer, pool.data());
+        size_t checked = 0;
+        for (const PackOp& op : lt.pool) {
+            const std::string name = at_layer(op.tensor, layer);
+            const auto& t = f.tensor(name);
+            const size_t fcols = t.dims[0];
+            const uint8_t* src = f.raw(name, nullptr);
+            const size_t per_band = op.in_dim / 128, bands = op.nch / per_band, prow = bands * 64;
+            const size_t bstride = op.band_stride ? op.band_stride : per_band * 4608;
+            for (int s = 0; s < samples; ++s) {
+                const size_t e = rng() % op.experts, r = rng() % prow, k = rng() % op.in_dim;
+                const float got = pool_q40(pool.data() + op.dst + e * op.expert_bytes, op.in_dim, bstride, r, k);
+                float want = 0.f;
+                const bool real = r < op.rows && k < op.src_dim;
+                const size_t frow = op.row0 + e * op.n_total + r, fcol = op.col0 + k;
+                if (real) want = file_q40(src, fcols, frow, fcol);
+                expect(got == want, name + " e" + std::to_string(e) + " r" + std::to_string(r) + " k" + std::to_string(k) +
+                                        " pool " + std::to_string(got) + " file " + std::to_string(want));
+                if (out && real) std::fprintf(out, "%s\t%zu\t%zu\t%.9g\n", name.c_str(), frow, fcol, got);
+                ++checked;
+            }
+        }
+        // the host steps' tensors: present, with the values their steps read
+        for (const Step& st : lt.program) {
+            for (const auto& [key, val] : st.nh_s) {
+                if (val.find("blk.") != 0) continue;
+                const std::string name = at_layer(val, layer);
+                expect(f.tensor(name).nvalues() > 0, "host tensor " + name);
+            }
+        }
+        std::printf("layer %d (%s): %zu ops, %zu samples, pool %zu MiB\n", layer, lt.name.c_str(), lt.pool.size(), checked,
+                    bytes >> 20);
+    }
+    {
+        std::vector<uint8_t> head(w.lmhead_pool_bytes);
+        pools::pack_lmhead(w, f, head.data());
+        const PackOp& op = w.lmhead_ops.at(0);
+        const auto& t = f.tensor(op.tensor);
+        const size_t cols = t.dims[0], rows = t.dims[1], nkt = op.in_dim / 256;
+        const uint8_t* src = f.raw(op.tensor, nullptr);
+        for (int s = 0; s < samples; ++s) {
+            const size_t r = rng() % op.rows, k = rng() % op.in_dim;
+            const size_t B = r / 128, q = (r % 128) / 32, rr = r % 32, kt = k / 256, kin = k % 256;
+            const uint8_t* c = head.data() + ((B * nkt + kt) * 4 + q) * 9216;
+            float sc;
+            std::memcpy(&sc, c + 4 * ((kin / 32) * 32 + rr), 4);
+            const float got = sc * static_cast<float>(static_cast<int8_t>(c[1024 + (rr / 16) * 4096 + kin * 16 + rr % 16]));
+            float want = 0.f;
+            if (r < rows && k < cols) {
+                const uint8_t* b = src + (r * (cols / 32) + k / 32) * 34;
+                uint16_t d;
+                std::memcpy(&d, b, 2);
+                want = h2f(d) * static_cast<float>(static_cast<int8_t>(b[2 + k % 32]));
+                if (out) std::fprintf(out, "%s\t%zu\t%zu\t%.9g\n", op.tensor.c_str(), r, k, got);
+            }
+            expect(got == want, "head r" + std::to_string(r) + " k" + std::to_string(k));
+        }
+        std::printf("head: %d samples\n", samples);
+    }
+    if (out) std::fclose(out);
+    std::printf(fails ? "PACK-CHECK FAIL (%d)\n" : "PACK-CHECK OK\n", fails);
+    return fails ? 1 : 0;
+}
