+void Core::xg_gemm(int l, size_t si, size_t rep, const float* x, size_t n, size_t K, float* y) {
+    const GemmBlockProgram& gb = types_[l]->gemm_block;
+    const Step& s = gb.program.at(si);
+    const size_t T = gemm_block_t_, rows = gb.xg_rows.at(si), N = (rows + 255) / 256 * 256;
+    if (rep >= gb.xg_count.at(si)) throw std::runtime_error("open_qwen36: xg_gemm: dispatch past the step's count");
+    Kern& k = kerns_.at(s.kernel);
+    // the weight: every fill on arg 0 re-pointed at the step's pool offset (compiled from 0)
+    auto& fills = xg_wfill_[s.kernel];
+    if (fills.empty()) {
+        const std::vector<uint32_t>& w = k.words;
+        for (size_t i = 4; i < w.size(); i += stream_patch::op_len(w[i]))
+            if (w[i] == 0x81 && i + 11 < w.size() && w[i + 8] == 0) fills.push_back({i + 10, w[i + 10]});
+        if (fills.empty()) throw std::runtime_error("open_qwen36: xg_gemm: " + s.kernel + " has no weight fills");
+    }
+    const uint64_t base = gb.xg_off.at(si) + rep * gb.xg_stride.at(si);
+    const uint64_t wbytes = N / 64 * (K / 128) * w_->chunk_bytes;
+    if (base + wbytes > pools_[l].size())
+        throw std::runtime_error("open_qwen36: xg_gemm: " + gb.xg_role[si] + " reads past layer " + std::to_string(l) +
+                                 "'s pool");
+    auto cur = xg_wbase_.find(s.kernel);
+    if (cur == xg_wbase_.end() || cur->second != base) {
+        auto tp = std::chrono::steady_clock::now();
+        uint32_t* iw = k.iw();
+        for (const auto& [word, off] : fills) {
+            const uint64_t v = base + off;
+            if (v >> 32) throw std::runtime_error("open_qwen36: xg_gemm: a fill past a 32-bit offset");
+            iw[word] = static_cast<uint32_t>(v);
+        }
+        k.instr->sync(XCL_BO_SYNC_BO_TO_DEVICE);
+        xg_wbase_[s.kernel] = base;
+        timing_.patch_ms += ms_since(tp);
+    }
+    // two x / y pairs (the globals and a "#1" twin each): chunk c + 1 is tiled while chunk c runs, and chunk c's
+    // y is untiled while chunk c + 1 runs -- one dispatch of the kernel in flight at a time (R-0008)
+    const std::string xa[2] = {s.args[1], s.args[1] + "#1"}, ya[2] = {s.args[2], s.args[2] + "#1"};
+    for (const std::string* p : {&xa[1], &ya[1]})
+        if (!globals_.count(*p)) globals_[*p] = alloc(w_->globals.at(p->substr(0, p->size() - 2)));
+    if (buffer(xa[0], 0).size() < K * T * 2 || buffer(ya[0], 0).size() < N * T * 4)
+        throw std::runtime_error("open_qwen36: xg_gemm " + s.kernel + ": the x / y globals are smaller than the GEMM");
+    std::vector<float> xs(T * K), yt(T * rows);
+    const size_t nch = (n + T - 1) / T;
+    auto stage = [&](size_t c, int b) {
+        auto t0 = std::chrono::steady_clock::now();
+        const size_t c0 = c * T, tr = std::min(T, n - c0);
+        std::memcpy(xs.data(), x + c0 * K, tr * K * 4);
+        std::fill(xs.begin() + static_cast<long>(tr * K), xs.end(), 0.0f);
+        xrt::bo& xb = buffer(xa[b], 0);
+        host::tile_x(xs.data(), T, K, xb.map<uint16_t*>());
+        xb.sync(XCL_BO_SYNC_BO_TO_DEVICE, K * T * 2, 0);
+        timing_.gemm_tile_ms += ms_since(t0);
+    };
+    auto finish = [&](size_t c, int b) {
+        auto t1 = std::chrono::steady_clock::now();
+        const size_t c0 = c * T, tr = std::min(T, n - c0);
+        xrt::bo& yb = buffer(ya[b], 0);
+        read_back(yb, rows * T * 4, 0);
+        host::transpose(yb.map<const float*>(), rows, T, yt.data());     // [rows, T] -> [T, rows]
+        std::memcpy(y + c0 * rows, yt.data(), tr * rows * 4);
+        timing_.gemm_tr_ms += ms_since(t1);
+    };
+    stage(0, 0);
+    Inflight f = start_run(k, {s.args[0], xa[0], ya[0]}, l);
+    for (size_t c = 0; c < nch; ++c) {
+        const int b = static_cast<int>(c & 1);
+        if (c + 1 < nch) stage(c + 1, b ^ 1);
+        timing_.part0_ms += wait_run(f).first;
+        if (c + 1 < nch) f = start_run(k, {s.args[0], xa[b ^ 1], ya[b ^ 1]}, l);
+        finish(c, b);
+    }
+}
+
+void Core::xg_experts(int l, const float* xm, const uint32_t* idx, const float* w, size_t n, float* m) {
+    const GemmBlockProgram& gb = types_[l]->gemm_block;
+    const size_t hid = w_->hidden, E = gb.xg_experts, K = gb.xg_topk, NT = gb.xg_nt;
+    if (NT != 8) throw std::runtime_error("open_qwen36: xg_experts: xmb is built for 8 token lanes");
+    auto tp = std::chrono::steady_clock::now();
+    std::vector<std::vector<std::pair<int, float>>> owed(E);   // per expert: its (token, weight) pairs
+    for (size_t t = 0; t < n; ++t)
+        for (size_t s = 0; s < K; ++s) {
+            const uint32_t e = idx[t * K + s];
+            if (e >= E) throw std::runtime_error("open_qwen36: xg_experts: expert " + std::to_string(e));
+            owed[e].push_back({static_cast<int>(t), w[t * K + s]});
+        }
+    std::vector<std::pair<uint32_t, size_t>> visits;             // (expert, first token of its NT)
+    for (size_t e = 0; e < E; ++e)
+        for (size_t off = 0; off < owed[e].size(); off += NT) visits.push_back({static_cast<uint32_t>(e), off});
+    if (visits.empty()) return;
+    // the passes: the shortest stream that holds the visits still owed, else the longest
+    struct Pass { size_t first, nv, slots; const std::string* kname; };
+    std::vector<Pass> passes;
+    for (size_t done = 0; done < visits.size();) {
+        const size_t left = visits.size() - done;
+        size_t slots = 0;
+        const std::string* kname = nullptr;
+        for (const auto& [sl, kn] : gb.xg_batch) {
+            slots = sl;
+            kname = &kn;
+            if (sl >= left) break;
+        }
+        passes.push_back({done, std::min(left, slots), slots, kname});
+        done += passes.back().nv;
+    }
+    // two x / y pairs (the globals and a "#1" twin): pass p + 1's x is gathered while pass p runs, pass p's y is
+    // scattered while pass p + 1 runs; a stream's fills are patched only once the run before it has finished
+    const std::vector<std::string>& args = gb.xg_batch_args;
+    const std::string xa[2] = {args[1], args[1] + "#1"}, ya[2] = {args[3], args[3] + "#1"};
+    for (const std::string* p : {&xa[1], &ya[1]})
+        if (!globals_.count(*p)) globals_[*p] = alloc(w_->globals.at(p->substr(0, p->size() - 2)));
+    const size_t smax = gb.xg_batch.rbegin()->first;
+    if (buffer(xa[0], 0).size() < smax * hid * NT * 2 || buffer(ya[0], 0).size() < smax * hid * NT * 4)
+        throw std::runtime_error("open_qwen36: xg_experts: the xmb x / y globals are too small");
+    std::vector<std::vector<std::pair<size_t, float>>> per_token[2] = {std::vector<std::vector<std::pair<size_t, float>>>(n),
+                                                                      std::vector<std::vector<std::pair<size_t, float>>>(n)};
+    const uint64_t pe = gb.xg_pool_exp, ups = gb.xg_ups, pd = gb.xg_pool_down, dns = gb.xg_dns;
+    auto gather = [&](const Pass& ps, int b) {
+        auto t0 = std::chrono::steady_clock::now();
+        for (auto& v : per_token[b]) v.clear();
+        for (size_t i = 0; i < ps.nv; ++i) {
+            const auto& [e, off] = visits[ps.first + i];
+            for (size_t j = 0; j < std::min(NT, owed[e].size() - off); ++j)
+                per_token[b][owed[e][off + j].first].push_back({i * NT + j, owed[e][off + j].second});
+        }
+        // x[slot] as the kernel's A tiles: [hid / 8][NT tokens][8 k] bf16 (designs/xing_batch/xmb.py, mbl's law);
+        // a visit's unused columns keep stale activations (the mmul's token lanes are independent: run-blk probe)
+        xrt::bo& xb = buffer(xa[b], 0);
+        uint16_t* xh = xb.map<uint16_t*>();
+#pragma omp parallel for schedule(static)
+        for (long long ii = 0; ii < static_cast<long long>(ps.nv); ++ii) {
+            const size_t i = static_cast<size_t>(ii);
+            const auto& [e, off] = visits[ps.first + i];
+            uint16_t* xs = xh + i * hid * NT;
+            for (size_t j = 0; j < std::min(NT, owed[e].size() - off); ++j) {
+                const float* row = xm + owed[e][off + j].first * hid;
+                for (size_t kb = 0; kb < hid / 8; ++kb)
+                    for (size_t kl = 0; kl < 8; ++kl) xs[(kb * NT + j) * 8 + kl] = f32_to_bf16(row[kb * 8 + kl]);
+            }
+        }
+        xb.sync(XCL_BO_SYNC_BO_TO_DEVICE, ps.nv * hid * NT * 2, 0);
+        timing_.moe_prep_ms += ms_since(t0);
+    };
+    auto patch = [&](const Pass& ps) -> Kern& {
+        auto t1 = std::chrono::steady_clock::now();
+        Kern& mk = kerns_.at(*ps.kname);
+        if (mk.moe2.empty()) {
+            // `xgbatch`: slot s's gate | up fills compiled at pe + s ups (+ intra), its down at pd + s dns
+            const std::vector<uint32_t>& wd = mk.words;
+            for (size_t i = 4; i < wd.size(); i += stream_patch::op_len(wd[i])) {
+                if (wd[i] != 0x81 || i + 11 >= wd.size() || wd[i + 8] != 0) continue;
+                const uint64_t off = wd[i + 10];
+                if (off >= pd) mk.moe2.push_back({i + 10, static_cast<size_t>((off - pd) / dns) | 0x100, 0, 0, (off - pd) % dns});
+                else if (off >= pe) mk.moe2.push_back({i + 10, static_cast<size_t>((off - pe) / ups), 0, 0, (off - pe) % ups});
+                else throw std::runtime_error("open_qwen36: xgbatch: " + *ps.kname + " has a fill before the experts");
+            }
+            for (const auto& p : mk.moe2) mk.slots = std::max(mk.slots, static_cast<size_t>((p.slot & 0xff) + 1));
+            if (mk.slots != ps.slots)
+                throw std::runtime_error("open_qwen36: xgbatch: " + *ps.kname + " carries " + std::to_string(mk.slots) +
+                                         " slots, the manifest says " + std::to_string(ps.slots));
+            log("xgbatch " + *ps.kname + ": " + std::to_string(mk.moe2.size()) + " expert fills over " +
+                std::to_string(mk.slots) + " slots");
+        }
+        std::vector<uint32_t> ex(ps.slots, 0);     // unused slots stream expert 0: a valid read, ignored
+        for (size_t i = 0; i < ps.nv; ++i) ex[i] = visits[ps.first + i].first;
+        uint32_t* iw = mk.iw();
+        for (const auto& p : mk.moe2) {
+            const uint64_t e = ex[p.slot & 0xff];
+            iw[p.word] = static_cast<uint32_t>((p.slot & 0x100) == 0 ? pe + e * ups + p.intra : pd + e * dns + p.intra);
+        }
+        mk.instr->sync(XCL_BO_SYNC_BO_TO_DEVICE);
+        timing_.moe_patch_ms += ms_since(t1);
+        return mk;
+    };
+    auto scatter = [&](const Pass& ps, int b) {
+        auto t2 = std::chrono::steady_clock::now();
+        xrt::bo& yb = buffer(ya[b], 0);
+        read_back(yb, ps.nv * hid * NT * 4, 0);
+        const float* yh = yb.map<float*>();
+        // y[slot]: per slot [rbg][half][row r][2 groups][2 parities][8 t][8 j] f32, a 64-row band b = 4 rbg + r
+        // holding row 64 b + 16 (2 half + group) + 2 j + parity (designs/lfm2moe_batch/layout.py y_from_dev);
+        // every token adds its experts in ascending expert order, whichever passes they fall in
+#pragma omp parallel for schedule(static)
+        for (long long tt = 0; tt < static_cast<long long>(n); ++tt) {
+            float* o = m + tt * hid;
+            for (const auto& [col, wt] : per_token[b][static_cast<size_t>(tt)]) {
+                const size_t ct = col % NT;
+                const float* sb = yh + (col / NT) * hid * NT;
+                for (size_t band = 0; band < hid / 64; ++band) {
+                    const float* el = sb + ((band / 4) * 8 + (band % 4)) * 256 + ct * 8;
+                    for (size_t half = 0; half < 2; ++half)
+                        for (size_t gg = 0; gg < 2; ++gg) {
+                            const float* even = el + half * 4 * 256 + (gg * 2) * 64;
+                            const float* odd = even + 64;
+                            float* d = o + band * 64 + (2 * half + gg) * 16;
+                            for (size_t jj = 0; jj < 8; ++jj) {
+                                d[2 * jj] += wt * even[jj];
+                                d[2 * jj + 1] += wt * odd[jj];
+                            }
+                        }
+                }
+            }
+        }
+        timing_.moe_read_ms += ms_since(t2);
+    };
+    gather(passes[0], 0);
+    Inflight f = start_run(patch(passes[0]), {args[0], xa[0], args[2], ya[0]}, l);
+    for (size_t p = 0; p < passes.size(); ++p) {
+        const int b = static_cast<int>(p & 1);
+        if (p + 1 < passes.size()) gather(passes[p + 1], b ^ 1);
+        timing_.moe_run_ms += wait_run(f).first;
+        if (p + 1 < passes.size()) f = start_run(patch(passes[p + 1]), {args[0], xa[b ^ 1], args[2], ya[b ^ 1]}, l);
+        scatter(passes[p], b);
+    }
+    timing_.route_ms += ms_since(tp);
+}
+
+void Core::xg_attention(int l, const Step& s, const float* q, size_t n, size_t pos0, float* ao) {
+    // xg_mla's attention for n tokens at pos0.. (their KV rows already written), in f32 as GEMMs, in either of two
+    // exact rearrangements of the same products:
+    //   absorbed  (xg_mla's form): q_lat = k_b[h] q_nope per query; the scores (q_lat . c_t + q_rope . r_t) over the
+    //             576-wide rows every head shares; ctx = sum_t p_t c_t (512 wide); out = v_b[h] ctx
+    //   expanded  (HF's form): every row's K_nope[h] = k_b[h]^T c_t and V[h] = v_b[h] c_t once for the call; the
+    //             scores q_nope . K_nope + q_rope . r_t (192 wide), out = sum_t p_t V[h]_t (128 wide)
+    // Per head and row, absorbed costs 576 + 512 multiply-adds a (query, row) pair and expanded 192 + 128, while the
+    // absorption is paid per query and the expansion per row: from position 0 expanded is ~2-3x fewer; a short
+    // continuation of a long context is cheaper absorbed. OFLM_OPEN_XG_ATTN=absorbed|expanded forces one.
+    const size_t nh = nh_sz(s, "heads"), nope = nh_sz(s, "nope"), rot = nh_sz(s, "rope"), vd = nh_sz(s, "v_dim");
+    const size_t kvl = nh_sz(s, "kv_lora");
+    const float scale = static_cast<float>(nh_num(s, "scale"));
+    const size_t qd = nope + rot, row = kvl + rot;
+    if (kvl % 8 || vd % 8 || nope % 8 || rot % 8 || rot / 2 > w_->rope_inv_freq.size() || types_[l]->state_row != row * 4)
+        throw std::runtime_error("open_qwen36: xg_attention: the MLA geometry");
+    auto ta = std::chrono::steady_clock::now();
+    xg_absorb(s, l);
+    const std::vector<float>& kbt = xg_kbt_.at(l);       // [h][nope][kvl]
+    const std::vector<float>& vbt = xg_vbt_.at(l);       // [h][kvl][vd]
+    const size_t n4 = (n + 3) / 4 * 4, L = pos0 + n, L4 = (L + 3) / 4 * 4, L8 = (L + 7) / 8 * 8;
+    const float* C = state_[l].map<float*>();
+    // the scratch is kept across layers and calls (grow-only): fresh 50-MB allocations page-faulted every layer.
+    // Padding (rows n..n4, columns L..L8) never reaches a real output: the softmax masks the columns past each
+    // query's rows and the padded rows' outputs are dropped
+    auto grow = [](std::vector<float>& v, size_t sz) { if (v.size() < sz) v.resize(sz); return v.data(); };
+    // K^T: the rows' 576 values as [row][L8]
+    float* CT = grow(xg_ct_, row * L8);
+    {
+        constexpr size_t TB = 64;                                  // 64 x 64 tiles: both sides walk cache lines
+        const size_t nr = (row + TB - 1) / TB, nt = (L + TB - 1) / TB;
+#pragma omp parallel for schedule(static)
+        for (long long bb = 0; bb < static_cast<long long>(nr * nt); ++bb) {
+            const size_t r0 = static_cast<size_t>(bb) % nr * TB, t0 = static_cast<size_t>(bb) / nr * TB;
+            const size_t r1 = std::min(row, r0 + TB), t1 = std::min(L, t0 + TB);
+            for (size_t t = t0; t < t1; ++t)
+                for (size_t r = r0; r < r1; ++r) CT[r * L8 + t] = C[t * row + r];
+        }
+    }
+    // the queries with their rope halves turned: [n4][nh][qd]
+    float* qp = grow(xg_qp_, n4 * nh * qd);
+    std::memcpy(qp, q, n * nh * qd * 4);
+#pragma omp parallel for schedule(static)
+    for (long long tt = 0; tt < static_cast<long long>(n); ++tt) {
+        const size_t t = static_cast<size_t>(tt);
+        for (size_t h = 0; h < nh; ++h) xg_rope(qp + (t * nh + h) * qd + nope, rot / 2, static_cast<double>(pos0 + t), w_->rope_inv_freq);
+    }
+    const double sumL = static_cast<double>(n) * static_cast<double>(pos0) + 0.5 * static_cast<double>(n) * (n + 1.0);
+    const double absorbed_mac = static_cast<double>(n) * (nope * kvl + kvl * vd) + sumL * (row + kvl);
+    const double expanded_mac = static_cast<double>(L) * (nope * kvl + kvl * vd) + sumL * (qd + vd);
+    static const std::string mode = [] { const char* e = std::getenv("OFLM_OPEN_XG_ATTN"); return std::string(e ? e : "auto"); }();
+    const bool expanded = mode == "expanded" || (mode != "absorbed" && expanded_mac < absorbed_mac);
+    float* op = grow(xg_op_, n4 * nh * vd);
+    xg_prof_[0] += ms_since(ta);
+    auto tq = std::chrono::steady_clock::now();
+    // one row block's softmax: P [rows][Lg8] of scores -> probabilities (unnormalised, inv = 1 / sum), causal
+    auto softmax = [&](float* P, size_t rows, size_t Lg8, const std::function<size_t(size_t)>& valid, float* inv) {
+        for (size_t rr = 0; rr < rows; ++rr) {
+            const size_t Lt = valid(rr);
+            float* p = P + rr * Lg8;
+            if (Lt == 0) { std::fill(p, p + Lg8, 0.0f); inv[rr] = 0.0f; continue; }   // a padding row
+            float mx = -std::numeric_limits<float>::infinity();
+            for (size_t j = 0; j < Lt; ++j) mx = std::max(mx, p[j] * scale);
+            double sum = 0.0;
+            for (size_t j = 0; j < Lt; ++j) {
+                p[j] = std::exp(p[j] * scale - mx);
+                sum += p[j];
+            }
+            for (size_t j = Lt; j < Lg8; ++j) p[j] = 0.0f;
+            inv[rr] = static_cast<float>(1.0 / sum);
+        }
+    };
+    if (!expanded) {
+        // Q' [n4][nh][row] = [q_lat | q_rope]
+        float* Q = grow(xg_q_, n4 * nh * row);
+#pragma omp parallel for schedule(static)
+        for (long long hh = 0; hh < static_cast<long long>(nh); ++hh) {
+            const size_t h = static_cast<size_t>(hh);
+            xg_sgemm(n4, kvl, nope, qp + h * qd, nh * qd, kbt.data() + h * nope * kvl, kvl, Q + h * row, nh * row, false);
+        }
+#pragma omp parallel for schedule(static)
+        for (long long tt = 0; tt < static_cast<long long>(n); ++tt)
+            for (size_t h = 0; h < nh; ++h)
+                std::memcpy(Q + (static_cast<size_t>(tt) * nh + h) * row + kvl, qp + (static_cast<size_t>(tt) * nh + h) * qd + nope, rot * 4);
+        xg_prof_[1] += ms_since(tq);
+        auto ts = std::chrono::steady_clock::now();
+        // the scores, softmax and ctx a group of G tokens (G * nh query rows) at a time
+        constexpr size_t G = 4;
+        float* ctx = grow(xg_ctx_, n4 * nh * kvl);
+        const size_t ngroups = (n + G - 1) / G;
+#pragma omp parallel
+        {
+            static thread_local std::vector<float> P;            // per OpenMP thread, grow-only
+            if (P.size() < G * nh * L8) P.resize(G * nh * L8);
+            std::vector<float> inv(G * nh);
+#pragma omp for schedule(dynamic, 1)
+            for (long long gg = 0; gg < static_cast<long long>(ngroups); ++gg) {
+                const size_t t0 = static_cast<size_t>(gg) * G, t1 = std::min(n, t0 + G), R = (t1 - t0) * nh;
+                const size_t Lg = pos0 + t1, Lg8 = (Lg + 7) / 8 * 8;
+                xg_sgemm(R, Lg8, row, Q + t0 * nh * row, row, CT, L8, P.data(), Lg8, false);
+                softmax(P.data(), R, Lg8, [&](size_t rr) { return pos0 + t0 + rr / nh + 1; }, inv.data());
+                float* cg = ctx + t0 * nh * kvl;
+                xg_sgemm(R, kvl, Lg, P.data(), Lg8, C, row, cg, kvl, false);
+                for (size_t rr = 0; rr < R; ++rr)
+                    for (size_t r = 0; r < kvl; ++r) cg[rr * kvl + r] *= inv[rr];
+            }
+        }
+        xg_prof_[2] += ms_since(ts);
+        auto to = std::chrono::steady_clock::now();
+        // out[t][h vd + j] = v_b[h] ctx[t][h]
+#pragma omp parallel for schedule(static)
+        for (long long hh = 0; hh < static_cast<long long>(nh); ++hh) {
+            const size_t h = static_cast<size_t>(hh);
+            xg_sgemm(n4, vd, kvl, ctx + h * kvl, nh * kvl, vbt.data() + h * kvl * vd, vd, op + h * vd, nh * vd, false);
+        }
+        xg_prof_[3] += ms_since(to);
+    } else {
+        // K_nope^T [h][nope][L8] = k_b[h]^T C_lat^T and V [h][L4][vd] = C_lat v_b[h]^T, every row of the call once
+        float* KT = grow(xg_q_, nh * nope * L8);
+        float* V = grow(xg_ctx_, nh * L4 * vd);
+        const float* Cl = C;                                       // C_lat rows [L4][row] (the latent at 0)
+        if (L4 * row * 4 > state_[l].size()) {                     // the padded rows past the cache's capacity
+            float* cp = grow(xg_cl_, L4 * row);
+            std::memcpy(cp, C, L * row * 4);
+            Cl = cp;
+        }
+#pragma omp parallel for schedule(dynamic, 1)
+        for (long long jj = 0; jj < static_cast<long long>(2 * nh); ++jj) {
+            const size_t h = static_cast<size_t>(jj) / 2;
+            if (jj % 2 == 0)
+                xg_sgemm(nope, L8, kvl, kbt.data() + h * nope * kvl, kvl, CT, L8, KT + h * nope * L8, L8, false);
+            else
+                xg_sgemm(L4, vd, kvl, Cl, row, vbt.data() + h * kvl * vd, vd, V + h * L4 * vd, vd, false);
+        }
+        xg_prof_[1] += ms_since(tq);
+        auto ts = std::chrono::steady_clock::now();
+        // per (head, block of TG queries): S = q_nope K_nope^T + q_rope r^T, softmax, out = P V
+        constexpr size_t TG = 64;
+        const size_t nb = (n4 + TG - 1) / TG;
+#pragma omp parallel
+        {
+            static thread_local std::vector<float> P;
+            if (P.size() < TG * L8) P.resize(TG * L8);
+            std::vector<float> inv(TG);
+#pragma omp for schedule(dynamic, 1)
+            for (long long jj = 0; jj < static_cast<long long>(nh * nb); ++jj) {
+                const size_t h = static_cast<size_t>(jj) % nh, b = static_cast<size_t>(jj) / nh;
+                const size_t t0 = b * TG, t1 = std::min(n4, t0 + TG), R = t1 - t0;
+                const size_t Lg = std::min(L, pos0 + t1), Lg8 = (Lg + 7) / 8 * 8;
+                const float* qh = qp + (t0 * nh + h) * qd;
+                xg_sgemm(R, Lg8, nope, qh, nh * qd, KT + h * nope * L8, L8, P.data(), Lg8, false);
+                xg_sgemm(R, Lg8, rot, qh + nope, nh * qd, CT + kvl * L8, L8, P.data(), Lg8, true);
+                softmax(P.data(), R, Lg8, [&](size_t rr) { return t0 + rr < n ? pos0 + t0 + rr + 1 : 0; }, inv.data());
+                float* oh = op + t0 * nh * vd + h * vd;
+                xg_sgemm(R, vd, Lg, P.data(), Lg8, V + h * L4 * vd, vd, oh, nh * vd, false);
+                for (size_t rr = 0; rr < R; ++rr)
+                    for (size_t j = 0; j < vd; ++j) oh[rr * nh * vd + j] *= inv[rr];
+            }
+        }
+        xg_prof_[2] += ms_since(ts);
+    }
+    std::memcpy(ao, op, n * nh * vd * 4);
+    timing_.attn_ms += ms_since(ta);
+}
+
+void Core::xg_tail_logits(const float* streams) {
+    auto t1 = std::chrono::steady_clock::now();
+    xrt::bo& xr = buffer("xres", 0);
+    const size_t bytes = 4 * w_->hidden * 4;
+    if (xr.size() < bytes) throw std::runtime_error("open_qwen36: xg_tail_logits: xres holds fewer than 4 streams");
+    std::memcpy(xr.map<uint8_t*>(), streams, bytes);
+    for (const Step& s : w_->tail) {
+        if (s.op != "run") host_step(s, 0);       // xg_final
+        else run(kerns_.at(s.kernel), s.args, 0);
+    }
+    xrt::bo& lg = buffer("logits", 0);
+    read_back(lg, w_->vocab * 4, 0);
+    std::memcpy(logits_host_.data(), lg.map<uint8_t*>(), w_->vocab * 4);
+    softcap_logits();
+    timing_.lmhead_ms += ms_since(t1);
+}
+
+void Core::xg_prefill(const int* ids, size_t n, bool want_logits) {
+    apply_thread_budget();
+    if (!weights_loaded_) throw std::runtime_error("open_qwen36: xg_prefill before load_weights");
+    if (n == 0) return;
+    const size_t pos0 = static_cast<size_t>(pos_);
+    if (pos0 + n > cfg_.max_ctx)
+        throw std::runtime_error("open_qwen36: a prefill of " + std::to_string(n) + " at position " + std::to_string(pos0) +
+                                 " is past the context capacity of " + std::to_string(cfg_.max_ctx));
+    for (size_t t = 0; t < n; ++t)
+        if (ids[t] < 0 || static_cast<size_t>(ids[t]) >= w_->vocab) throw std::runtime_error("open_qwen36: token id out of range");
+    // A call costs its full-width GEMMs and a context change into xmb and back a layer however few tokens it holds,
+    // so a short prompt -- or a short continuation, as prompt reuse hands the bridge -- runs one token at a time on
+    // the sequential program (the same KV rows). The crossover is measured (.plans/xing.md, run-blk/crossover);
+    // OFLM_OPEN_XG_BLOCK_MIN overrides it (1: always the block route).
+    static const size_t min_block = [] {
+        const char* e = std::getenv("OFLM_OPEN_XG_BLOCK_MIN");
+        return e ? static_cast<size_t>(std::strtoul(e, nullptr, 10)) : static_cast<size_t>(XG_BLOCK_MIN);
+    }();
+    if (n < min_block) {
+        std::vector<std::vector<float>> all;
+        for (size_t t = 0; t < n; ++t) {
+            step(ids[t], (want_logits && t + 1 == n) || block_logits_all_);
+            if (block_logits_all_) all.push_back(logits_host_);
+        }
+        block_logits_ = std::move(all);
+        return;
+    }
+    auto t0 = std::chrono::steady_clock::now();
+    timing_ = StepTiming{};
+    const size_t hid = w_->hidden, hc = 4, sw = hc * hid;
+    std::vector<float> S(n * sw);                                // every token's four streams
+    for (size_t t = 0; t < n; ++t) {
+        float* st = S.data() + t * sw;
+        embedding_row(static_cast<size_t>(ids[t]), st);
+        for (size_t i = 1; i < hc; ++i) std::memcpy(st + i * hid, st, hid * 4);
+    }
+    std::vector<double> post(n * 4), comb(n * 16);
+    std::vector<float> hn(n * hid), y, qa, q, ao, o(n * hid), mo(n * hid), hbuf;
+    std::vector<uint32_t> idx;
+    std::vector<float> wts;
+    for (int l = 0; l < nl_; ++l) {
+        const LayerType& lt = *types_[l];
+        const GemmBlockProgram& gb = lt.gemm_block;
+        const Step *pa = nullptr, *pq = nullptr, *pm = nullptr, *pf = nullptr;   // the sequential program's host steps
+        for (const Step& s : lt.program) {
+            if (s.op == "xg_pre") (nh_str(s, "mode") == "x" ? pa : pf) = &s;
+            else if (s.op == "xg_qnorm") pq = &s;
+            else if (s.op == "xg_mla") pm = &s;
+        }
+        if (!pa || !pq || !pm || !pf)
+            throw std::runtime_error("open_qwen36: xg_prefill: layer " + std::to_string(l) + "'s program lacks an xg_* step");
+        auto role = [&](const char* r) -> size_t {
+            for (size_t i = 0; i < gb.xg_role.size(); ++i)
+                if (gb.xg_role[i] == r) return i;
+            throw std::runtime_error(std::string("open_qwen36: xg_prefill: no ") + r + " step on layer " + std::to_string(l));
+        };
+        // mHC pre (+ the sublayer's norm) for every token, the sublayer's post / comb kept per token
+        auto mhc = [&](const Step& s) {
+            auto tp = std::chrono::steady_clock::now();
+            const std::vector<float>& fn = xg_tensor(nh_str(s, "hc_fn"), l, 24 * sw);
+            const std::vector<float>& base = xg_tensor(nh_str(s, "hc_base"), l, 24);
+            const std::vector<float>& sc = xg_tensor(nh_str(s, "hc_scale"), l, 3);
+            const std::vector<float>& nw = nh_tensor(nh_str(s, "norm"), l, hid);
+            if (nh_sz(s, "hc") != hc || nh_sz(s, "hidden") != hid) throw std::runtime_error("open_qwen36: xg_prefill: mHC geometry");
+            const double eps = nh_num(s, "eps"), heps = nh_num(s, "hc_eps"), clamp = nh_num(s, "hc_clamp");
+            const size_t iters = nh_sz(s, "hc_iters");
+#pragma omp parallel for schedule(static)
+            for (long long gg = 0; gg < static_cast<long long>((n + 3) / 4); ++gg) {
+                const size_t t0 = static_cast<size_t>(gg) * 4, G = std::min<size_t>(4, n - t0);
+                const float* Sg[4];
+                double* pg[4];
+                double* cg[4];
+                float* hg[4];
+                for (size_t g = 0; g < G; ++g) {
+                    Sg[g] = S.data() + (t0 + g) * sw;
+                    pg[g] = post.data() + (t0 + g) * 4;
+                    cg[g] = comb.data() + (t0 + g) * 16;
+                    hg[g] = hn.data() + (t0 + g) * hid;
+                }
+                xg_mhc_rows(Sg, G, hid, fn.data(), base.data(), sc.data(), nw.data(), eps, heps, clamp, iters, pg, cg, hg);
+            }
+            timing_.prenorm_ms += ms_since(tp);
+        };
+        auto mhc_post = [&](const float* yv) {
+            auto tp = std::chrono::steady_clock::now();
+#pragma omp parallel for schedule(static)
+            for (long long tt = 0; tt < static_cast<long long>(n); ++tt) {
+                const size_t t = static_cast<size_t>(tt);
+                xg_post_row(S.data() + t * sw, yv + t * hid, hid, post.data() + t * 4, comb.data() + t * 16);
+            }
+            timing_.tail_ms += ms_since(tp);
+        };
+        // ---- attention
+        mhc(*pa);
+        const size_t sq = role("qkva"), sb = role("qb"), so = role("o"), sug = role("ffn_ug"), sdn = role("ffn_dn");
+        const size_t ql = nh_sz(*pq, "q_lora"), kvl = nh_sz(*pq, "kv_lora"), rot = nh_sz(*pq, "rope");
+        const size_t nhd = nh_sz(*pm, "heads"), qd = nh_sz(*pm, "nope") + nh_sz(*pm, "rope"), vd = nh_sz(*pm, "v_dim");
+        if (gb.xg_rows[sq] != ql + kvl + rot || gb.xg_rows[sb] != nhd * qd || gb.xg_rows[so] != hid ||
+            lt.state_row != (kvl + rot) * 4)
+            throw std::runtime_error("open_qwen36: xg_prefill: layer " + std::to_string(l) + "'s GEMM rows and its MLA steps disagree");
+        y.resize(n * gb.xg_rows[sq]);
+        xg_gemm(l, sq, 0, hn.data(), n, hid, y.data());
+        {
+            // q_a_norm -> qa; kv_a_norm on the latent and RoPE on the key's rope part -> the KV row at pos0 + t
+            auto tp = std::chrono::steady_clock::now();
+            const std::vector<float>& qw = nh_tensor(nh_str(*pq, "q_norm"), l, ql);
+            const std::vector<float>& kw = nh_tensor(nh_str(*pq, "kv_norm"), l, kvl);
+            const double eps = nh_num(*pq, "eps");
+            qa.resize(n * ql);
+            float* kv = state_[l].map<float*>();
+            const size_t yr = gb.xg_rows[sq];
+#pragma omp parallel for schedule(static)
+            for (long long tt = 0; tt < static_cast<long long>(n); ++tt) {
+                const size_t t = static_cast<size_t>(tt);
+                const float* yt = y.data() + t * yr;
+                float* rw = kv + (pos0 + t) * (kvl + rot);
+                xg_rms(yt, qw.data(), ql, eps, qa.data() + t * ql);
+                xg_rms(yt + ql, kw.data(), kvl, eps, rw);
+                std::memcpy(rw + kvl, yt + ql + kvl, rot * 4);
+                xg_rope(rw + kvl, rot / 2, static_cast<double>(pos0 + t), w_->rope_inv_freq);
+            }
+            timing_.state_ms += ms_since(tp);
+        }
+        q.resize(n * nhd * qd);
+        xg_gemm(l, sb, 0, qa.data(), n, ql, q.data());
+        ao.resize(n * nhd * vd);
+        xg_attention(l, *pm, q.data(), n, pos0, ao.data());
+        xg_gemm(l, so, 0, ao.data(), n, nhd * vd, o.data());
+        mhc_post(o.data());
+        // ---- FFN
+        mhc(*pf);
+        const std::string& mode = nh_str(*pf, "mode");
+        const size_t ff = gb.xg_ff;
+        std::fill(mo.begin(), mo.end(), 0.0f);
+        hbuf.resize(n * ff);
+        y.resize(n * gb.xg_rows[sug]);
+        xg_gemm(l, sug, 0, hn.data(), n, hid, y.data());
+        if (mode == "dense") {
+            // the dense MLP as xg_slots 1024-wide slices: slice j's gate | up at rows j 2 ff, its down a dispatch each
+            const size_t slices = gb.xg_count[sdn];
+            if (gb.xg_rows[sug] != slices * 2 * ff || slices != nh_sz(*pf, "slots"))
+                throw std::runtime_error("open_qwen36: xg_prefill: the dense slices disagree");
+            std::vector<float> yd(n * hid);
+            for (size_t j = 0; j < slices; ++j) {
+                xg_swiglu(y.data(), gb.xg_rows[sug], j * 2 * ff, n, ff, hbuf.data());
+                xg_gemm(l, sdn, j, hbuf.data(), n, ff, yd.data());
+                for (size_t i = 0; i < n * hid; ++i) mo[i] += yd[i];
+            }
+        } else if (mode == "route") {
+            // the router per token, the shared expert as two GEMMs, the routed experts on xmb
+            auto tp = std::chrono::steady_clock::now();
+            const size_t E = nh_sz(*pf, "experts"), K = nh_sz(*pf, "topk");
+            if (E != gb.xg_experts || K != gb.xg_topk) throw std::runtime_error("open_qwen36: xg_prefill: the router geometry");
+            const std::vector<float>& wr = xg_tensor(nh_str(*pf, "router"), l, E * hid);
+            const std::vector<float>& bias = xg_tensor(nh_str(*pf, "bias"), l, E);
+            const double rscale = nh_num(*pf, "scale");
+            idx.resize(n * K);
+            wts.resize(n * K);
+#pragma omp parallel for schedule(static)
+            for (long long gg = 0; gg < static_cast<long long>((n + 3) / 4); ++gg) {
+                const size_t t0 = static_cast<size_t>(gg) * 4, G = std::min<size_t>(4, n - t0);
+                const float* hg[4];
+                uint32_t* ig[4];
+                float* wg[4];
+                for (size_t g = 0; g < G; ++g) {
+                    hg[g] = hn.data() + (t0 + g) * hid;
+                    ig[g] = idx.data() + (t0 + g) * K;
+                    wg[g] = wts.data() + (t0 + g) * K;
+                }
+                xg_route_rows(hg, G, hid, wr.data(), bias.data(), E, K, rscale, ig, wg);
+            }
+            timing_.prenorm_ms += ms_since(tp);
+            if (route_log_on_)
+                for (size_t t = 0; t < n; ++t) {
+                    uint32_t ri[16] = {};
+                    float rw[16] = {};
+                    for (size_t j = 0; j < K; ++j) { ri[j] = idx[t * K + j]; rw[j] = wts[t * K + j]; }
+                    ri[K] = static_cast<uint32_t>(E);
+                    rw[K] = 1.0f;
+                    std::vector<uint8_t> rec(sizeof ri + sizeof rw);
+                    std::memcpy(rec.data(), ri, sizeof ri);
+                    std::memcpy(rec.data() + sizeof ri, rw, sizeof rw);
+                    route_log_.push_back({l, rec});
+                }
+            xg_swiglu(y.data(), gb.xg_rows[sug], 0, n, ff, hbuf.data());
+            xg_gemm(l, sdn, 0, hbuf.data(), n, ff, mo.data());
+            xg_experts(l, hn.data(), idx.data(), wts.data(), n, mo.data());
+        } else {
+            throw std::runtime_error("open_qwen36: xg_prefill: FFN mode " + mode);
+        }
+        mhc_post(mo.data());
+    }
+    pos_ += static_cast<int>(n);
+    block_logits_.clear();
+    if (block_logits_all_)
+        for (size_t t = 0; t < n; ++t) {
+            xg_tail_logits(S.data() + t * sw);
+            block_logits_.push_back(logits_host_);
+        }
+    if (want_logits) xg_tail_logits(S.data() + (n - 1) * sw);
+    timing_.part1_ms = timing_.prenorm_ms + timing_.tail_ms + timing_.state_ms + timing_.attn_ms + timing_.gemm_tile_ms +
+                       timing_.gemm_tr_ms;
+    timing_.total_ms = ms_since(t0);
+    static const bool prof = std::getenv("OFLM_OPEN_XG_PROF") != nullptr;
+    if (prof)
+        std::fprintf(stderr, "open_qwen36: xg_prefill %zu tokens at %zu: %.1f ms; attention: rows / K^T %.1f, q absorbed %.1f, "
+                     "scores + softmax + ctx %.1f, out %.1f; mHC + router %.1f, post %.1f, q/kv norm %.1f; GEMM run %.1f, "
+                     "tile %.1f, untile %.1f, patch %.1f; xmb run %.1f, prep %.1f, read %.1f (all %.1f); head %.1f\n",
+                     n, pos0, timing_.total_ms, xg_prof_[0], xg_prof_[1], xg_prof_[2], xg_prof_[3], timing_.prenorm_ms,
+                     timing_.tail_ms, timing_.state_ms, timing_.part0_ms, timing_.gemm_tile_ms, timing_.gemm_tr_ms,
+                     timing_.patch_ms, timing_.moe_run_ms, timing_.moe_prep_ms, timing_.moe_read_ms, timing_.route_ms,
+                     timing_.lmhead_ms);
+    for (double& v : xg_prof_) v = 0.0;
+}
