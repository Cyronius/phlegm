+"""Issue #212 catalog checks against inspected public container headers."""
+import json
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[3]
+
+def test_catalog_quantization_matches_inspected_container_formats():
+    fixtures = json.loads((Path(__file__).parent / "fixtures/artlite_catalog_headers.json").read_text())
+    catalog = json.loads((ROOT / "src/model_list.json").read_text())
+    by_name = {m["name"]: m for sizes in catalog["models"].values() for m in sizes.values()}
+    for model in fixtures["models"]:
+        assert model["quantized_chunk_bytes"] == [5120, 8704]
+        assert by_name[model["model"]]["details"]["quantization_level"] == "Q4_1 + Q8"
+
+def test_llama_tokenizer_and_external_template_ship_together():
+    catalog = json.loads((ROOT / "src/model_list.json").read_text())
+    files = json.loads((ROOT / "src/model_info.json").read_text())["llama3.1:8b"]
+    by_path = {f["path"]: f for f in files}
+    assert "chat_template.jinja" in catalog["models"]["llama3.1"]["8b"]["files"]
+    assert by_path["tokenizer_config.json"]["size"] == 185
+    assert by_path["tokenizer_config.json"]["oid"] == "72f138ab40e9c48724f5e94eb77f2b524d50559b"
+    assert by_path["chat_template.jinja"]["oid"] == "33089ace1be88f22a10fe861ad49718d5d886090"
+
+
+def test_small_catalog_models_have_complete_default_export_specs(monkeypatch):
+    # Do not bypass the catalog's numerical-validation boundary to make an export pass.
+    monkeypatch.delenv("OPEN_KERNELS_UNVALIDATED", raising=False)
+    from recipes.load import load_spec
+    from recipes.manifest import manifest
+
+    catalog = json.loads((ROOT / "src/model_list.json").read_text())
+    for family, size, filename in (("llama3.2", "1b", "llama32-1b"),
+                                   ("llama3.2", "3b", "llama32-3b"),
+                                   ("qwen3", "0.6b", "qwen3-0.6b")):
+        spec = load_spec(ROOT / "open_kernels/recipes/specs" / (filename + ".json"))
+        assert spec.extra["model"] == catalog["models"][family][size]["name"]
+        m = manifest(spec)
+        assert len(m["layers"]) == spec.num_layers
+        assert {"dx", "ln", "lm_head_q4", "dx_f32", "lm_head_q4_f32", "dx_attn"} <= m["builds"].keys()
+        for kernel in m["kernels"].values():
+            assert kernel["build"] in m["builds"]
+        assert m["layer_types"]["dense"]["gemm_block"]["program"]
