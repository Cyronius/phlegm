+
+void Q4nxFile::embed_row(const std::string& name, size_t row, size_t dim, float* out) const {
+    const TensorMeta& t = meta(name);
+    if (t.dtype == "BF16") { bf16_row(name, row, dim, out); return; }
+    // Q4NX Q8 is a raster of 32-row x 256-column tiles: 256 bf16 scales,
+    // then 8192 signed codes in the same 16-lane raster as the linear pools.
+    // Decode only the requested row, directly from the mapping, never the table.
+    if (t.dtype != "I8" || t.shape.size() != 3 || t.shape[2] != 8704 || !t.shape[0] || !t.shape[1])
+        throw std::runtime_error("q4nx: " + name + " embedding needs BF16 rows or Q8 [row_tiles, col_tiles, 8704]");
+    const size_t cols = t.shape[1], bytes = t.end - t.start;
+    if (cols > bytes / 8704 || bytes % 8704 || bytes / 8704 / cols != t.shape[0] ||
+        bytes / 8704 % cols || cols > dim / 256)
+        throw std::runtime_error("q4nx: " + name + " Q8 embedding shape/payload or requested width disagrees");
+    if (row / 32 >= t.shape[0])
+        throw std::runtime_error("q4nx: row " + std::to_string(row) + " past " + name);
+    const size_t rr = row % 32;
+    for (size_t c = 0; c < cols; ++c) {
+        const uint8_t* chunk = map_ + data_base_ + t.start + ((row / 32) * cols + c) * 8704;
+        for (size_t b = 0; b < 8; ++b) {
+            uint16_t scale;
+            std::memcpy(&scale, chunk + 2 * (b * 32 + rr), 2);
+            const float d = bf16_to_f32(scale);
+            for (size_t i = 0; i < 32; ++i) {
+                const size_t code = (rr / 16) * 4096 + b * 512 + i * 16 + rr % 16;
+                int8_t q;
+                std::memcpy(&q, chunk + 512 + code, 1);
+                out[c * 256 + b * 32 + i] = d * static_cast<float>(q);
+            }
+        }
+    }
+    for (size_t i = cols * 256; i < dim; ++i) out[i] = 0.f;
 }
 
