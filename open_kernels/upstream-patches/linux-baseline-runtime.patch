+// Issue #212: native Q8 embedding rows must equal the stored values, not a requantized pool.
+#include "open_qwen36/q4nx_file.hpp"
+#include "nlohmann/json.hpp"
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+using namespace open_qwen36;
+namespace fs = std::filesystem;
+static const std::string name = "model.embed_tokens.weight";
+static void require(bool ok) { if (!ok) throw std::runtime_error("Q4NX embedding test failed"); }
+static float scale(size_t row, size_t col) { return float(1 + row % 5) / 8 + float((col % 256) / 32) / 16 + float(col / 256) / 32; }
+static int code(size_t row, size_t col) { return int((row * 17 + col * 3) % 255) - 127; }
+static fs::path make_file(const fs::path& dir, const std::string& label, const std::string& dtype,
+                          std::vector<size_t> shape, const std::vector<uint8_t>& bytes) {
+    nlohmann::json h;
+    h[name] = {{"dtype", dtype}, {"shape", shape}, {"data_offsets", {0, bytes.size()}}};
+    const auto text = h.dump(); const uint64_t size = text.size();
+    const auto path = dir / (label + ".q4nx");
+    std::ofstream f(path, std::ios::binary);
+    f.write(reinterpret_cast<const char*>(&size), 8); f << text;
+    f.write(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+    return path;
+}
+template<class F> static void refuses(F f) { bool bad = false; try { f(); } catch (const std::runtime_error&) { bad = true; } require(bad); }
+int main() {
+    const auto dir = fs::temp_directory_path() / ("oflm-embed-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    fs::create_directories(dir);
+    std::vector<uint8_t> q8(4 * 8704);
+    for (size_t rt = 0; rt < 2; ++rt) for (size_t ct = 0; ct < 2; ++ct) {
+        auto* chunk = q8.data() + (rt * 2 + ct) * 8704;
+        for (size_t rr = 0; rr < 32; ++rr) for (size_t b = 0; b < 8; ++b) {
+            const uint16_t d = f32_to_bf16(scale(rt * 32 + rr, ct * 256 + b * 32));
+            std::memcpy(chunk + 2 * (b * 32 + rr), &d, 2);
+            for (size_t i = 0; i < 32; ++i) {
+                const auto q = static_cast<int8_t>(code(rt * 32 + rr, ct * 256 + b * 32 + i));
+                std::memcpy(chunk + 512 + (rr / 16) * 4096 + b * 512 + i * 16 + rr % 16, &q, 1);
+            }
+        }
+    }
+    const auto path = make_file(dir, "q8", "I8", {2, 2, 8704}, q8);
+    {
+        Q4nxFile f(path.string()); std::vector<float> out(576);
+        for (size_t row = 0; row < 64; ++row) {
+            f.embed_row(name, row, out.size(), out.data());
+            for (size_t c = 0; c < 512; ++c) require(out[c] == scale(row, c) * code(row, c));
+            for (size_t c = 512; c < out.size(); ++c) require(out[c] == 0.f);
+        }
+        refuses([&]{f.embed_row(name, 64, 576, out.data());});
+        refuses([&]{f.embed_row(name, std::numeric_limits<size_t>::max(), 576, out.data());});
+        refuses([&]{f.embed_row(name, 0, 511, out.data());});
+    }
+    for (const auto& shape : {std::vector<size_t>{2, 3, 8704}, {2, 2, 5120}, {0, 2, 8704}}) {
+        const auto bad = make_file(dir, "bad" + std::to_string(shape[0]) + std::to_string(shape[1]) + std::to_string(shape[2]), "I8", shape, q8);
