+void Q4nxFile::embed_row(const std::string& name, size_t row, size_t dim, float* out) const {
+    const TensorMeta& t = meta(name);
+    if (t.dtype == "BF16") { bf16_row(name, row, dim, out); return; }
+    // Q4NX Q8 is a raster of 32-row x 256-column tiles: 256 bf16 scales,
+    // then 8192 signed codes in the same 16-lane raster as the linear pools.
+    // Decode only the requested row, directly from the mapping, never the table.
+    if (t.dtype != "I8" || t.shape.size() != 3 || t.shape[2] != 8704 || !t.shape[0] || !t.shape[1])
+        throw std::runtime_error("q4nx: " + name + " embedding needs BF16 rows or Q8 [row_tiles, col_tiles, 8704]");
+    const size_t cols = t.shape[1], bytes = t.end - t.start;
