+void Core::flint_route(const Step& s, int layer) {
+    // Flint's router (OPEN-FAMILY-FLINT; transformers' FlintTopKRouter, llama.cpp's build_moe_ffn with
+    // the sigmoid gate): logits = W xm over xm as fl_att wrote it (bf16), in double; scores = sigmoid;
+    // the top `r_topk` scores (ties to the lower expert, as a stable sort gives), renormalised over the
+    // chosen -- no bias, scale 1. Then each `shared` pool expert (the ungated shared expert's halves) in
+    // the next slot at weight 1. The weights go beside xm, inside the x element fl_moe's cores take
+    // (fl_wgrab); the slots' experts into fl_moe's fills (moeroute2's table).
+    auto t0 = std::chrono::steady_clock::now();
+    Kern& k = kerns_.at(s.kernel);
+    if (k.moe2.empty()) throw std::runtime_error("open_qwen36: flint_route on " + k.name + ", which has no routed-expert table");
+    const size_t hr = s.hidden_real, E = s.r_experts, K = s.r_topk, S = K + s.shared.size();
+    if (hr > w_->hidden || S != w_->moe.topk || E > w_->moe.experts)
+        throw std::runtime_error("open_qwen36: flint_route geometry (topk + shared must be the moe slots)");
+    auto it = fl_router_.find(layer);
+    if (it == fl_router_.end()) {
+        std::string n = s.router;
+        for (size_t p = n.find("{l}"); p != std::string::npos; p = n.find("{l}")) n.replace(p, 3, std::to_string(layer));
+        std::vector<float> w = file_->f32(n);
+        if (w.size() != E * hr)
+            throw std::runtime_error("open_qwen36: layer " + std::to_string(layer) + ": flint_route's router is not [" +
+                                     std::to_string(E) + ", " + std::to_string(hr) + "]");
+        it = fl_router_.emplace(layer, std::move(w)).first;
+    }
+    const std::vector<float>& W = it->second;
+    xrt::bo& act = act_[layer];
+    read_back(act, hr * 2, s.a_xm);
+    const uint16_t* xb = reinterpret_cast<const uint16_t*>(act.map<uint8_t*>() + s.a_xm);
+    std::vector<double> x(hr);
+    for (size_t i = 0; i < hr; ++i) x[i] = bf16_to_f32(xb[i]);
+    std::vector<double> score(E);
+    for (size_t e = 0; e < E; ++e) {
+        const float* wr = W.data() + e * hr;
+        double acc = 0.0;
+        for (size_t i = 0; i < hr; ++i) acc += static_cast<double>(wr[i]) * x[i];
+        score[e] = 1.0 / (1.0 + std::exp(-acc));
+    }
+    std::vector<uint32_t> order(E);
+    for (size_t e = 0; e < E; ++e) order[e] = static_cast<uint32_t>(e);
+    std::stable_sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b) { return score[a] > score[b]; });
+    uint32_t idx[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    float wv[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    double sum = 0.0;
+    for (size_t j = 0; j < K; ++j) sum += score[order[j]];
+    for (size_t j = 0; j < K; ++j) {
+        idx[j] = order[j];
+        wv[j] = static_cast<float>(score[order[j]] / sum);
+    }
+    for (size_t j = 0; j < s.shared.size(); ++j) {
+        idx[K + j] = s.shared[j];
+        wv[K + j] = 1.0f;
+    }
+    uint8_t* a = act.map<uint8_t*>();
+    std::memcpy(a + s.a_w, wv, sizeof wv);
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, sizeof wv, s.a_w);
+    if (route_log_on_) {
+        std::vector<uint8_t> rec(sizeof idx + sizeof wv);
+        std::memcpy(rec.data(), idx, sizeof idx);
+        std::memcpy(rec.data() + sizeof idx, wv, sizeof wv);
+        route_log_.push_back({layer, rec});
+    }
+    for (size_t j = 0; j < S; ++j)
+        if (idx[j] >= w_->moe.experts) throw std::runtime_error("open_qwen36: flint_route slot expert " + std::to_string(idx[j]));
+    stream_patch::moe2_apply(k.iw(), k.moe2, idx, w_->moe);
+    k.instr->sync(XCL_BO_SYNC_BO_TO_DEVICE);
+    timing_.route_ms += ms_since(t0);
+}
