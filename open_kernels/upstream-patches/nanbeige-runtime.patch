diff -ruN --suppress-blank-empty patch-a/src/open_qwen36/gguf_pack_dump.cpp patch-b/src/open_qwen36/gguf_pack_dump.cpp
--- a/src/open_qwen36/gguf_pack_dump.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/src/open_qwen36/gguf_pack_dump.cpp	2026-11-07 07:04:35.483651914 -0600
@@ -0,0 +1,65 @@
+/// \file gguf_pack_dump.cpp
+/// \brief No-XRT tool for a dense GGUF view (OPEN-FAMILY-NANBEIGE): packs the named layers' pool and
+///        consts (and optionally the head) from model.gguf through the manifest's gguf section, exactly
+///        as Core does (pools::pack_pool / pack_consts / pack_lmhead), and writes the bytes for an
+///        independent decode (open_kernels/model/nanbeige_gguf_check.py). Opens no device.
+///
+///     gguf_pack_dump <manifest.json> <model.gguf> <out_dir> <layer,layer,...|-> [head]
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "open_qwen36/gguf_file.hpp"
+#include "open_qwen36/manifest.hpp"
+#include "open_qwen36/pools.hpp"
+
+using namespace open_qwen36;
+
+static void write(const std::string& path, const std::vector<uint8_t>& b) {
+    std::ofstream f(path, std::ios::binary);
+    f.write(reinterpret_cast<const char*>(b.data()), static_cast<std::streamsize>(b.size()));
+    if (!f) throw std::runtime_error("cannot write " + path);
+}
+
+int main(int argc, char** argv) {
+    if (argc < 5) {
+        std::fprintf(stderr, "usage: %s manifest.json model.gguf out_dir layers|- [head]\n", argv[0]);
+        return 2;
+    }
+    try {
+        Manifest top = Manifest::load(argv[1]);
+        if (!top.gguf) throw std::runtime_error("the manifest has no gguf section");
+        const Manifest& m = *top.gguf;
+        GgufFile g(argv[2]);
+        const std::string out = argv[3];
+        if (std::string(argv[4]) != "-") {
+            std::stringstream ss(argv[4]);
+            std::string tok;
+            while (std::getline(ss, tok, ',')) {
+                const int l = std::atoi(tok.c_str());
+                const LayerType& lt = m.layer_type(static_cast<size_t>(l));
+                std::vector<uint8_t> pool(m.pool_bytes), consts(lt.consts_bytes);
+                pools::pack_pool(m, lt, g, l, pool.data());
+                pools::pack_consts(m, lt, g, l, consts.data());
+                write(out + "/pool" + tok + ".bin", pool);
+                write(out + "/consts" + tok + ".bin", consts);
+                std::printf("layer %d (%s): pool %zu B (chunk %zu), consts %zu B\n", l, lt.name.c_str(), pool.size(),
+                            static_cast<size_t>(m.chunk_bytes), consts.size());
+            }
+        }
+        if (argc > 5 && std::string(argv[5]) == "head") {
+            std::vector<uint8_t> head(m.lmhead_pool_bytes);
+            pools::pack_lmhead(m, g, head.data());
+            write(out + "/lmhead.bin", head);
+            std::printf("head: %zu B\n", head.size());
+        }
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "gguf_pack_dump: %s\n", e.what());
+        return 1;
+    }
+    return 0;
+}
