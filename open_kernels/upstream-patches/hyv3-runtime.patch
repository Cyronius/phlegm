+void Core::hy_route(const Step& s, int layer) {
+    // HY V3's router (OPEN-FAMILY-HYV3; transformers' HYV3TopKRouter, llama.cpp's build_moe_ffn with the
+    // sigmoid gate, exp_probs_b, expert_weights_norm and expert_weights_scale): logits = W xm over xm as
+    // hy_att wrote it (bf16), in double; s = sigmoid; the top `r_topk` of s + bias (ties to the lower
+    // expert, as a stable sort gives); the weights are the chosen UNBIASED s / their sum * r_scale. Then
+    // each `shared` pool expert (the ungated shared expert) in the next slot at weight 1. Dense mode (the
+    // leading dense-MLP layer): slots 0..r_slots-1 are pool experts 0..r_slots-1 at weight 1. The weights
+    // (f32[16]) go beside xm, inside the x element hy_moe's cores take (hy_wgrab); the slots' experts into
+    // hy_moe's fills (moeroute2's table).
+    auto t0 = std::chrono::steady_clock::now();
+    Kern& k = kerns_.at(s.kernel);
+    if (k.moe2.empty()) throw std::runtime_error("open_qwen36: hy_route on " + k.name + ", which has no routed-expert table");
+    const size_t S = s.r_slots;
+    if (S != w_->moe.topk || S > 16)
+        throw std::runtime_error("open_qwen36: hy_route geometry (its slots must be the moe slots, at most 16)");
+    uint32_t idx[16] = {0};
+    float wv[16] = {0};
+    if (s.r_dense) {
+        for (size_t j = 0; j < S; ++j) {
+            idx[j] = static_cast<uint32_t>(j);
+            wv[j] = 1.0f;
+        }
+    } else {
+        const size_t hr = s.hidden_real, E = s.r_experts, K = s.r_topk;
+        if (hr > w_->hidden || E > w_->moe.experts || K + s.shared.size() != S)
+            throw std::runtime_error("open_qwen36: hy_route geometry (topk + shared must be the moe slots)");
+        auto it = hy_router_.find(layer);
+        if (it == hy_router_.end()) {
+            auto name = [&](std::string n) {
+                for (size_t p = n.find("{l}"); p != std::string::npos; p = n.find("{l}")) n.replace(p, 3, std::to_string(layer));
+                return n;
+            };
+            std::vector<float> w = file_->f32(name(s.router)), b = file_->f32(name(s.router_bias));
+            if (w.size() != E * hr || b.size() != E)
+                throw std::runtime_error("open_qwen36: layer " + std::to_string(layer) + ": hy_route's router is not [" +
+                                         std::to_string(E) + ", " + std::to_string(hr) + "] with a [" + std::to_string(E) +
+                                         "] bias");
+            it = hy_router_.emplace(layer, std::make_pair(std::move(w), std::move(b))).first;
+        }
+        const std::vector<float>& W = it->second.first;
+        const std::vector<float>& B = it->second.second;
+        xrt::bo& act = act_[layer];
+        read_back(act, hr * 2, s.a_xm);
+        const uint16_t* xb = reinterpret_cast<const uint16_t*>(act.map<uint8_t*>() + s.a_xm);
+        std::vector<double> x(hr);
+        for (size_t i = 0; i < hr; ++i) x[i] = bf16_to_f32(xb[i]);
+        std::vector<double> score(E), choice(E);
+        for (size_t e = 0; e < E; ++e) {
+            const float* wr = W.data() + e * hr;
+            double acc = 0.0;
+            for (size_t i = 0; i < hr; ++i) acc += static_cast<double>(wr[i]) * x[i];
+            score[e] = 1.0 / (1.0 + std::exp(-acc));
+            choice[e] = score[e] + static_cast<double>(B[e]);
+        }
+        std::vector<uint32_t> order(E);
+        for (size_t e = 0; e < E; ++e) order[e] = static_cast<uint32_t>(e);
+        std::stable_sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b) { return choice[a] > choice[b]; });
+        double sum = 0.0;
+        for (size_t j = 0; j < K; ++j) sum += score[order[j]];
+        for (size_t j = 0; j < K; ++j) {
+            idx[j] = order[j];
+            wv[j] = static_cast<float>(score[order[j]] / (sum + 1e-20) * s.r_scale);
+        }
+        for (size_t j = 0; j < s.shared.size(); ++j) {
+            idx[K + j] = s.shared[j];
+            wv[K + j] = 1.0f;
+        }
+    }
+    xrt::bo& act = act_[layer];
+    uint8_t* a = act.map<uint8_t*>();
+    std::memcpy(a + s.a_w, wv, sizeof wv);
+    act.sync(XCL_BO_SYNC_BO_TO_DEVICE, sizeof wv, s.a_w);
+    if (route_log_on_) {
+        std::vector<uint8_t> rec(sizeof idx + sizeof wv);
+        std::memcpy(rec.data(), idx, sizeof idx);
+        std::memcpy(rec.data() + sizeof idx, wv, sizeof wv);
+        route_log_.push_back({layer, rec});
+    }
+    for (size_t j = 0; j < S; ++j)
+        if (idx[j] >= w_->moe.experts) throw std::runtime_error("open_qwen36: hy_route slot expert " + std::to_string(idx[j]));
+    stream_patch::moe2_apply(k.iw(), k.moe2, idx, w_->moe);
+    k.instr->sync(XCL_BO_SYNC_BO_TO_DEVICE);
+    timing_.route_ms += ms_since(t0);
+}
