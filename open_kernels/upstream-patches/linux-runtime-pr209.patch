+                std::memcpy(&q, chunk + 512 + code, 1);
+                out[c * 256 + b * 32 + i] = d * static_cast<float>(q);
+            }
+        }
+    }
+    for (size_t i = cols * 256; i < dim; ++i) out[i] = 0.f;
+}
