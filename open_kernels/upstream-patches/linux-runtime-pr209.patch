+                           const double denom = exp_sum_f32(s.data(), p + 1, mx);
+                           const float inv = static_cast<float>(1.0 / denom);
+                           std::fill(acc, acc + hd, 0.f);
+                           for (size_t r = 0; r <= p; ++r) axpy_f32(acc, s[r] * inv, Vf + r * kvw + off, hd);
+                           std::memcpy(og + t * qw + h * hd, acc, hd * 4);
