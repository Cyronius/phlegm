+void axpy_f32(float* out, float a, const float* v, size_t n) {
+    const __m256 va = _mm256_set1_ps(a);
+    for (size_t j = 0; j < n; j += 8)
+        _mm256_storeu_ps(out + j, _mm256_fmadd_ps(va, _mm256_loadu_ps(v + j), _mm256_loadu_ps(out + j)));
