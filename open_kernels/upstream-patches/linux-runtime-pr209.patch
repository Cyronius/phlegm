+    gemm_phase(l, gb.program[1], B, T, qw, hid,
+               [&](size_t b) -> const float* { return npu_attn ? af_o[b]->map<const float*>() : og_all + b * T * qw; },
+               [&](size_t b, const float* y) {
+                   const double* xr = xres.data() + b * T * hid;
