--- /dev/null
+++ b/src/open_qwen36/bfp_hilo_pack_test.cpp
@@ -0,0 +1,76 @@
+#include "open_qwen36/block_host.hpp"
+#include <algorithm>
+#include <cfenv>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+static float as_float(uint32_t u) {float f;std::memcpy(&f,&u,4);return f;}
+// Independent nearest-neighbor BF16 reference, without the production bit-rounder.
+static float rounded_bf16(float f) {
+    uint32_t u;std::memcpy(&u,&f,4);
+    uint16_t bits=static_cast<uint16_t>(u>>16);
+    float a=as_float(uint32_t(bits)<<16),b=as_float(uint32_t(bits+1)<<16);
+    double da=std::abs(double(f)-a),db=std::abs(double(f)-b);
+    return da<db||(da==db&&!(bits&1))?a:b;
+}
+static double nearest_even(double x) {
+    double a=std::floor(x),r=x-a;
+    return a+double(r>.5||(r==.5&&std::fmod(std::abs(a),2.)!=0));
+}
+static void encode(const float *v,uint8_t *out,float *decoded) {
+    double m=0;for(int i=0;i<8;++i)m=std::max(m,std::abs(double(v[i])));
+    if(m==0) {std::memset(out,0,9);std::fill(decoded,decoded+8,0);return;}
+    int e=0;std::frexp(std::max(m,std::ldexp(1.,-120)),&e);e=e-1+127;
+    double q[8];bool over=false;
+    for(int i=0;i<8;++i){q[i]=nearest_even(std::ldexp(double(v[i]),133-e));over|=q[i]>127;}
+    if(over){++e;for(int i=0;i<8;++i)q[i]=nearest_even(std::ldexp(double(v[i]),133-e));}
+    out[0]=uint8_t(e);
+    for(int i=0;i<8;++i){out[i+1]=uint8_t(int8_t(q[i]));decoded[i]=std::ldexp(float(q[i]),e-133);}
+}
+static void check(bool ok,const char *what) {if(!ok)throw std::runtime_error(what);}
+static void test(size_t T,size_t K) {
+    std::mt19937 rng(212);std::uniform_real_distribution<float>d(-4,4);
+    const float edge[]={0,-0.f,1.9921875f,-1.9921875f,1.00390625f,-1.00390625f,
+                        std::ldexp(1.f,-120),std::ldexp(1.f,-130)};
+    std::vector<float>x(T*K);for(auto &v:x)v=d(rng);
+    for(size_t t=0;t<std::min(T,size_t(8));++t)
+        for(size_t k=0;k<K;++k)x[t*K+k]=t==0?0:edge[(k+t)%8];
+    std::vector<uint8_t>expected(T*K*9/4,0xff),got(expected.size());
+    for(size_t t=0;t<T;++t)for(size_t k=0;k<K;k+=8) {
+        float v[8],hi[8],lo[8],discard[8];uint8_t hb[9],lb[9];
+        for(int i=0;i<8;++i)v[i]=rounded_bf16(x[t*K+k+i]);
+        encode(v,hb,hi);
+        for(int i=0;i<8;++i)lo[i]=rounded_bf16(v[i]-hi[i]);
+        encode(lo,lb,discard);
+        size_t tile=(k/64)*(T/32)+t/32;
+        size_t off=((tile*4+(t%32)/8)*8+(k%64)/8)*144+(t%8)*9;
+        std::memcpy(expected.data()+off,hb,9);std::memcpy(expected.data()+off+72,lb,9);
+    }
+    for(int mode:{FE_TONEAREST,FE_DOWNWARD,FE_UPWARD}) {
+        std::fesetround(mode);
+        open_qwen36::host::tile_bfp16_hilo(x.data(),T,K,got.data());
+        check(expected==got,"hilo bytes differ from independent scalar reference");
+    }
+    std::fesetround(FE_TONEAREST);
+    std::cout<<"PASS "<<T<<"x"<<K<<" layout and rounding modes\n";
+}
+int main() {
+    try {
+        test(32,64);test(256,2048);test(256,8192);test(512,2048);
+        std::vector<float>x(32*64);std::vector<uint8_t>y(x.size()*9/4);
+        for(float bad:{std::numeric_limits<float>::quiet_NaN(),std::numeric_limits<float>::infinity(),-std::numeric_limits<float>::infinity(),2e20f}) {
+            x.back()=bad;bool threw=false;
+            try{open_qwen36::host::tile_bfp16_hilo(x.data(),32,64,y.data());}catch(const std::runtime_error&){threw=true;}
+            check(threw,"nonfinite/out-of-range input accepted");
+        }
+        bool threw=false;try{open_qwen36::host::tile_bfp16_hilo(x.data(),31,64,y.data());}catch(const std::runtime_error&){threw=true;}
+        check(threw,"invalid shape accepted");
+        std::cout<<"PASS bounded input and shape guards\n";
+    } catch(const std::exception&e){std::cerr<<e.what()<<"\n";return 1;}
+}
