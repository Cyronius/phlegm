+                         timing_.mid_ms += ms_since(th);
+                         timing_.attn_ms += ms_since(th);
+                     },
+                     [&](size_t j) {
+                         const AJ& a = aj[j];
+                         const auto th = now();
+                         const host::AttnGeom g = geom(a.b);
+                         const size_t first = host::attn_first_row(g);
