+    for (const PackOp& op : ops) {
+        const size_t rows = op.nch / (op.in_dim / 256) * 32;
+        for (size_t g = op.row0 / t.n; g < (op.row0 + rows) / t.n && g < groups; ++g) hit[g] = 1;
