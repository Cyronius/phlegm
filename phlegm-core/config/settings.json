{
  "version": 1,
  "settings": [
    {
      "key": "speculative",
      "cli_flag": "--speculative",
      "env_var": "PHLEGM_SPECULATIVE",
      "description": "Speculative decoding; opt-in until model and method gates pass",
      "type": "enum",
      "options": [
        {
          "value": "off"
        },
        {
          "value": "auto"
        },
        {
          "value": "lookup"
        },
        {
          "value": "mtp"
        }
      ],
      "scope": "per_model",
      "delivery": "direct",
      "category": "performance",
      "reload_required": false,
      "registry_key": "speculative",
      "default_value": "off"
    },
    {
      "key": "prefill_mode",
      "cli_flag": "--prefill-mode",
      "description": "Memory/speed trade-off for prefill",
      "type": "enum",
      "options": [
        {"value": "fast", "description": "Default prefill, higher memory"},
        {"value": "lean", "description": "Lower memory, slower"}
      ],
      "scope": "per_model",
      "delivery": "direct",
      "category": "performance",
      "reload_required": true,
      "default_value": "fast"
    },
    {
      "key": "prefill_route",
      "cli_flag": "--prefill-route",
      "description": "How the prompt is prefilled",
      "type": "enum",
      "options": [
        {"value": "auto", "description": "The fastest route the kernel set has (layer-major, then block, then sequential)"},
        {"value": "block", "description": "Batched GEMM blocks"},
        {"value": "sequential", "description": "One token at a time through the decode kernels"}
      ],
      "scope": "per_model",
      "delivery": "direct",
      "category": "performance",
      "reload_required": true,
      "default_value": "auto"
    },
    {
      "key": "ctx_len",
      "cli_flag": "--max-ctx",
      "description": "Context window length in tokens (prompt plus output)",
      "type": "int",
      "min_value": 2,
      "presets": [4096, 8192, 16384, 32768, 65536, 131072],
      "scope": "per_model",
      "delivery": "direct",
      "category": "memory",
      "reload_required": true,
      "registry_key": "default_context_length",
      "default_value": 32768
    },
    {
      "key": "think",
      "cli_flag": "--think",
      "description": "Think before answering by default (the chat template's enable_thinking, or its reasoning_effort off value)",
      "type": "bool",
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "details.think",
      "default_value": true
    },
    {
      "key": "reasoning_effort",
      "cli_flag": "--reasoning-effort",
      "description": "How much a reasoning model thinks (OpenAI's reasoning_effort), translated to the chat template's own values; default follows think",
      "type": "enum",
      "options": [
        {"value": "default", "description": "Follow think: the model's usual thinking, or none"},
        {"value": "none", "description": "No thinking where the model can skip it, else its least"},
        {"value": "minimal", "description": "The model's nearest level to minimal"},
        {"value": "low", "description": "The model's nearest level to low"},
        {"value": "medium", "description": "The model's nearest level to medium"},
        {"value": "high", "description": "The model's nearest level to high"},
        {"value": "xhigh", "description": "The model's nearest level to xhigh"}
      ],
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "details.reasoning_effort",
      "default_value": "default"
    },
    {
      "key": "temperature",
      "cli_flag": "--temperature",
      "description": "Sampling temperature; 0 is greedy",
      "type": "float",
      "min_value": 0,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.temperature",
      "generation_config": "temperature",
      "default_value": 0
    },
    {
      "key": "top_k",
      "cli_flag": "--top-k",
      "description": "Sample from the k most likely tokens; 0 is off",
      "type": "int",
      "min_value": 0,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.top_k",
      "generation_config": "top_k",
      "default_value": 0
    },
    {
      "key": "top_p",
      "cli_flag": "--top-p",
      "description": "Nucleus sampling: the smallest set of tokens whose probability reaches p; 1 is off",
      "type": "float",
      "min_value": 0,
      "min_exclusive": true,
      "max_value": 1,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.top_p",
      "generation_config": "top_p",
      "default_value": 1.0
    },
    {
      "key": "repetition_penalty",
      "cli_flag": "--repetition-penalty",
      "description": "Divides the logits of tokens already in the context (HF convention); 1 is off",
      "type": "float",
      "min_value": 0,
      "min_exclusive": true,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.repetition_penalty",
      "generation_config": "repetition_penalty",
      "default_value": 1.0
    },
    {
      "key": "repetition_penalty_scope",
      "cli_flag": "--repetition-penalty-scope",
      "description": "Which tokens the repetition penalty counts: the whole context (HF, llama.cpp, vLLM) or only the reply (Clover)",
      "type": "enum",
      "options": [{"value": "context", "description": "The prompt and the reply"}, {"value": "response", "description": "Only the reply"}],
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.repetition_penalty_scope",
      "default_value": "context"
    },
    {
      "key": "presence_penalty",
      "cli_flag": "--presence-penalty",
      "description": "Subtracted from the logit of every token already in the reply (OpenAI); 0 is off",
      "type": "float",
      "min_value": -2,
      "max_value": 2,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.presence_penalty",
      "generation_config": "presence_penalty",
      "default_value": 0.0
    },
    {
      "key": "frequency_penalty",
      "cli_flag": "--frequency-penalty",
      "description": "Subtracted from a token's logit once per time it is already in the reply (OpenAI); 0 is off",
      "type": "float",
      "min_value": -2,
      "max_value": 2,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.frequency_penalty",
      "generation_config": "frequency_penalty",
      "default_value": 0.0
    },
    {
      "key": "length_bias",
      "cli_flag": "--length-bias",
      "description": "Added to the stop tokens' logits, rising from 0 after length_bias_start reply tokens to this over length_bias_window more (Clover's dllm_length_penalty); 0 is off",
      "type": "float",
      "min_value": 0,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.length_bias",
      "generation_config": "dllm_length_penalty",
      "default_value": 0.0
    },
    {
      "key": "length_bias_start",
      "cli_flag": "--length-bias-start",
      "description": "Reply tokens before length_bias starts",
      "type": "int",
      "min_value": 0,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.length_bias_start",
      "generation_config": "dllm_length_penalty_start",
      "default_value": 8192
    },
    {
      "key": "length_bias_window",
      "cli_flag": "--length-bias-window",
      "description": "Reply tokens over which length_bias rises to full",
      "type": "int",
      "min_value": 1,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.length_bias_window",
      "generation_config": "dllm_length_penalty_window",
      "default_value": 8192
    },
    {
      "key": "think_end_bias",
      "cli_flag": "--think-end-bias",
      "description": "Added to the reasoning block's closing token (</think>) until the reply closes it, rising from 0 after think_end_start reply tokens to this over think_end_window more (Clover's dllm_think_end_bias); 0 is off",
      "type": "float",
      "min_value": 0,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.think_end_bias",
      "generation_config": "dllm_think_end_bias",
      "default_value": 0.0
    },
    {
      "key": "think_end_start",
      "cli_flag": "--think-end-start",
      "description": "Reply tokens before think_end_bias starts",
      "type": "int",
      "min_value": 0,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.think_end_start",
      "generation_config": "dllm_think_end_start",
      "default_value": 4096
    },
    {
      "key": "think_end_window",
      "cli_flag": "--think-end-window",
      "description": "Reply tokens over which think_end_bias rises to full",
      "type": "int",
      "min_value": 1,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "registry_key": "sampling.think_end_window",
      "generation_config": "dllm_think_end_window",
      "default_value": 4096
    },
    {
      "key": "max_tokens",
      "cli_flag": "--max-tokens",
      "env_var": "PHLEGM_MAX_TOKENS",
      "description": "Output tokens for a request that does not set max_tokens; 0 is until a stop token or the end of the context",
      "type": "int",
      "min_value": 0,
      "scope": "per_model",
      "delivery": "api_field",
      "category": "generation",
      "reload_required": false,
      "default_value": 0
    }
  ]
}
